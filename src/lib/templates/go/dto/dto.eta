<%~ includeFile('../../header.eta', it) %>

package dto

<% if (it.importTime || it.importEnums) { %>
import (
<% if (it.importTime) { %>
	"time"
<% } %>
<% if (it.importEnums) { %>
	"app/autogen/models/enums"
<% } %>
)
<% } %>

// <%= it.entityName %>Response represents the response DTO for <%= it.entityName %>
type <%= it.entityName %>Response struct {
<% if (it.addDefaultPKProperty) { -%>
<% if (it.primaryKeyType === 'uuid') { -%>
	ID        string    `json:"id"`
<% } else { -%>
	ID        uint      `json:"id"`
<% } -%>
<% } -%>
<% it.columns.forEach((column) => { -%>
<%~ includeFile('./dto-col-' + column.dtoTemplate + '.eta', { column, mode: 'response' }) %>
<% }); -%>
<% if (it.createdAt) { -%>
	CreatedAt time.Time `json:"createdAt"`
<% } -%>
<% if (it.updatedAt) { -%>
	UpdatedAt time.Time `json:"updatedAt"`
<% } -%>
<% it.associations.forEach((assoc) => { -%>
<% if (assoc.owns) { -%>
	<%= assoc.fkField %> <%= assoc.fkGoType %> `json:"<%= assoc.camelReferenceName %>Id"`
	<%= assoc.fieldName %> *<%= assoc.name %>Response `json:"<%= assoc.jsonName %>,omitempty"`
<% } else if (assoc.type === 'OneToOne') { -%>
	<%= assoc.fieldName %> *<%= assoc.name %>Response `json:"<%= assoc.jsonName %>,omitempty"`
<% } else if (assoc.type === 'OneToMany' || (assoc.type === 'ManyToMany' && assoc.join)) { -%>
	<%= assoc.fieldName %> []<%= assoc.name %>Response `json:"<%= assoc.jsonName %>,omitempty"`
<% } -%>
<% }) -%>
}

// <%= it.entityName %>Create represents the create DTO for <%= it.entityName %>
type <%= it.entityName %>Create struct {
<% it.columns.forEach((column) => { -%>
<%~ includeFile('./dto-col-' + column.dtoTemplate + '.eta', { column, mode: 'create' }) %>
<% }); -%>
<% it.associations.forEach((assoc) => { -%>
<% if (assoc.owns) { -%>
	<%= assoc.fkField %> <%= assoc.fkGoType %> `json:"<%= assoc.camelReferenceName %>Id<% if (assoc.fkNullable) { %>,omitempty<% } %>"<% if (!assoc.scoped && !assoc.fkNullable) { %> validate:"required"<% } %>`
<% } -%>
<% }) -%>
}

// <%= it.entityName %>Update represents the update DTO for <%= it.entityName %>
type <%= it.entityName %>Update struct {
<% it.columns.forEach((column) => { -%>
<%~ includeFile('./dto-col-' + column.dtoTemplate + '.eta', { column, mode: 'update' }) %>
<% }); -%>
<% it.associations.forEach((assoc) => { -%>
<% if (assoc.owns) { -%>
	<%= assoc.fkField %> *<%= assoc.primaryKeyGoType %> `json:"<%= assoc.camelReferenceName %>Id,omitempty"`
<% } -%>
<% }) -%>
}

// <%= it.entityName %>PaginatedResponse wraps paginated results for <%= it.entityName %>
type <%= it.entityName %>PaginatedResponse struct {
	Data      []<%= it.entityName %>Response `json:"data"`
	Count     int                   `json:"count"`
	Total     int64                 `json:"total"`
	Page      int                   `json:"page"`
	PageCount int                   `json:"pageCount"`
}
