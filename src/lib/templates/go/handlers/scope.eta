package handlers

import (
	"errors"
	"net/http"
	"strings"

	"app/autogen/services"
	"github.com/gin-gonic/gin"
)

// scopeError answers a scoped entity's service error: 403 when the caller has
// no tenant, 404 when the row is missing or belongs to another tenant.
// It reports whether it wrote a response.
func scopeError(c *gin.Context, err error) bool {
	if errors.Is(err, services.ErrForbidden) {
		c.JSON(http.StatusForbidden, gin.H{"error": err.Error()})
		return true
	}
	if strings.HasSuffix(err.Error(), "not found") {
		c.JSON(http.StatusNotFound, gin.H{"error": err.Error()})
		return true
	}
	return false
}
