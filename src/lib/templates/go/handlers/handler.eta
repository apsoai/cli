<%~ includeFile('../../header.eta', it) %>

package handlers

import (
	"net/http"
	"strconv"

	"app/autogen/dto"
	"app/autogen/services"
	"app/autogen/utils"
	"github.com/gin-gonic/gin"
	"github.com/go-playground/validator/v10"
)

type <%= it.entityName %>Handler struct {
	service  *services.<%= it.entityName %>Service
	validate *validator.Validate
}

func New<%= it.entityName %>Handler(service *services.<%= it.entityName %>Service) *<%= it.entityName %>Handler {
	return &<%= it.entityName %>Handler{
		service:  service,
		validate: validator.New(),
	}
}

// RegisterRoutes registers all routes for <%= it.entityName %>
func (h *<%= it.entityName %>Handler) RegisterRoutes(r *gin.RouterGroup) {
	group := r.Group("/<%= it.kebabPluralName %>")
	{
		group.GET("", h.FindAll)
		group.GET("/:id", h.FindOne)
		group.POST("", h.Create)
		group.PUT("/:id", h.Update)
		group.PATCH("/:id", h.Update)
		group.DELETE("/:id", h.Delete)
	}
}

// FindAll godoc
// @Summary      List all <%= it.pluralName %>
// @Description  Get a paginated list of <%= it.pluralName %> with filtering, sorting, and joins
// @Tags         <%= it.pluralName %>
// @Accept       json
// @Produce      json
// @Param        filter   query    string  false  "Filter: field||$operator||value (repeatable)"
// @Param        or       query    string  false  "OR filter: field||$operator||value (repeatable)"
// @Param        sort     query    string  false  "Sort: field,ASC or field,DESC (repeatable)"
// @Param        fields   query    string  false  "Field selection: field1,field2"
// @Param        join     query    string  false  "Join: relation or relation||field1,field2 (repeatable)"
// @Param        limit    query    int     false  "Page size (max 200)"  default(25)
// @Param        page     query    int     false  "Page number"          default(1)
// @Param        select   query    string  false  "PostgREST projection: col,alias:col"
// @Param        order    query    string  false  "PostgREST order: col.asc|desc[.nullsfirst|nullslast]"
// @Param        offset   query    int     false  "PostgREST row offset (bare-array response)"
// @Success      200  {object}  dto.<%= it.entityName %>PaginatedResponse
// @Failure      400  {object}  map[string]string
// @Failure      500  {object}  map[string]string
// @Router       /<%= it.kebabPluralName %> [get]
//
// Dual-dialect: the nestjsx dialect (filter/sort/join/fields/or) returns the
// {data,count,total,page,pageCount} envelope; the PostgREST dialect
// (select/order/col=op.value/or=()/and=()) returns a bare JSON array. The
// dialect is chosen by the X-Crud-Dialect header or the query-param shape.
func (h *<%= it.entityName %>Handler) FindAll(c *gin.Context) {
	opts, err := utils.ParseQuery(c.Request.URL.Query(), c.GetHeader("X-Crud-Dialect"))
	if err != nil {
		// A malformed dialect request (bad header, ambiguous mix, bad operator)
		// is a client error, not a 500 (apso #60).
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	// PostgREST dialect => bare JSON array (no envelope) — apso #58.
	if opts.Bare {
		rows, err := h.service.FindAllBare(c.Request.Context(), opts)
		if err != nil {
			if qe, ok := utils.AsQueryError(err); ok {
				c.JSON(http.StatusBadRequest, gin.H{"error": qe.Error()})
				return
			}
			c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
			return
		}
		c.JSON(http.StatusOK, rows)
		return
	}

	result, err := h.service.FindAll(c.Request.Context(), opts)
	if err != nil {
		if qe, ok := utils.AsQueryError(err); ok {
			c.JSON(http.StatusBadRequest, gin.H{"error": qe.Error()})
			return
		}
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	c.JSON(http.StatusOK, result)
}

// FindOne godoc
// @Summary      Get a <%= it.entityName %>
// @Description  Get a <%= it.entityName %> by ID
// @Tags         <%= it.pluralName %>
// @Accept       json
// @Produce      json
// @Param        id   path      <%= it.primaryKeySwaggerType || 'integer' %>  true  "<%= it.entityName %> ID"
// @Success      200  {object}  dto.<%= it.entityName %>Response
// @Failure      404  {object}  map[string]string
// @Failure      500  {object}  map[string]string
// @Router       /<%= it.kebabPluralName %>/{id} [get]
func (h *<%= it.entityName %>Handler) FindOne(c *gin.Context) {
	id := c.Param("id")
<% if (it.primaryKeyType === 'uuid') { %>
	// UUID primary key
<% } else { %>
	idInt, err := strconv.ParseUint(id, 10, 32)
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid ID format"})
		return
	}
	id = strconv.FormatUint(idInt, 10)
<% } %>

	result, err := h.service.FindOne(c.Request.Context(), id)
	if err != nil {
		c.JSON(http.StatusNotFound, gin.H{"error": "<%= it.entityName %> not found"})
		return
	}

	c.JSON(http.StatusOK, result)
}

// Create godoc
// @Summary      Create a <%= it.entityName %>
// @Description  Create a new <%= it.entityName %>
// @Tags         <%= it.pluralName %>
// @Accept       json
// @Produce      json
// @Param        body  body      dto.<%= it.entityName %>Create  true  "<%= it.entityName %> data"
// @Success      201   {object}  dto.<%= it.entityName %>Response
// @Failure      400   {object}  map[string]string
// @Failure      500   {object}  map[string]string
// @Router       /<%= it.kebabPluralName %> [post]
func (h *<%= it.entityName %>Handler) Create(c *gin.Context) {
	var input dto.<%= it.entityName %>Create
	if err := c.ShouldBindJSON(&input); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	if err := h.validate.Struct(input); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	result, err := h.service.Create(c.Request.Context(), &input)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	c.JSON(http.StatusCreated, result)
}

// Update godoc
