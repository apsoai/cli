// @Description  Update an existing <%= it.entityName %>
// @Tags         <%= it.pluralName %>
// @Accept       json
// @Produce      json
// @Param        id    path      <%= it.primaryKeySwaggerType || 'integer' %>  true  "<%= it.entityName %> ID"
// @Param        body  body      dto.<%= it.entityName %>Update  true  "<%= it.entityName %> data"
// @Success      200   {object}  dto.<%= it.entityName %>Response
// @Failure      400   {object}  map[string]string
// @Failure      404   {object}  map[string]string
// @Failure      500   {object}  map[string]string
// @Router       /<%= it.kebabPluralName %>/{id} [put]
func (h *<%= it.entityName %>Handler) Update(c *gin.Context) {
	id := c.Param("id")
<% if (it.primaryKeyType === 'uuid') { %>
	// UUID primary key
<% } else { %>
	idInt, err := strconv.ParseUint(id, 10, 32)
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid ID format"})
		return
	}
	id = strconv.FormatUint(idInt, 10)
<% } %>

	var input dto.<%= it.entityName %>Update
	if err := c.ShouldBindJSON(&input); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	if err := h.validate.Struct(input); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	result, err := h.service.Update(c.Request.Context(), id, &input)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	c.JSON(http.StatusOK, result)
}

// Delete godoc
// @Summary      Delete a <%= it.entityName %>
// @Description  Delete a <%= it.entityName %> by ID
// @Tags         <%= it.pluralName %>
// @Accept       json
// @Produce      json
// @Param        id   path      <%= it.primaryKeySwaggerType || 'integer' %>  true  "<%= it.entityName %> ID"
// @Success      204
// @Failure      404  {object}  map[string]string
// @Failure      500  {object}  map[string]string
// @Router       /<%= it.kebabPluralName %>/{id} [delete]
func (h *<%= it.entityName %>Handler) Delete(c *gin.Context) {
	id := c.Param("id")
<% if (it.primaryKeyType === 'uuid') { %>
	// UUID primary key
<% } else { %>
	idInt, err := strconv.ParseUint(id, 10, 32)
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid ID format"})
		return
	}
	id = strconv.FormatUint(idInt, 10)
<% } %>

	if err := h.service.Delete(c.Request.Context(), id); err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	c.Status(http.StatusNoContent)
}
