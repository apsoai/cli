<%~ includeFile('../../header.eta', it) %>

package services

import (
	"context"
	"errors"

	"app/autogen/dto"
<% if (it.scope) { %>
	"app/autogen/middleware"
<% } %>
	"app/autogen/models"
	"app/autogen/utils"
	"gorm.io/gorm"
)

// AllowedFields<%= it.entityName %> defines the column names that can be used in
// filter and sort query parameters. This prevents arbitrary column access.
var AllowedFields<%= it.entityName %> = map[string]bool{
	"id": true,
<% it.columns.forEach((column) => { %>
	"<%= column.snakeName %>": true,
<% }) %>
<% if (it.createdAt) { %>
	"created_at": true,
<% } %>
<% if (it.updatedAt) { %>
	"updated_at": true,
<% } %>
<% it.associations.filter(a => a.type === 'ManyToOne' || (a.type === 'OneToOne' && a.isOwner)).forEach((assoc) => { %>
	"<%= assoc.snakeReferenceName || assoc.snakeName %>_id": true,
<% }) %>
}

type <%= it.entityName %>Service struct {
	db *gorm.DB
}

func New<%= it.entityName %>Service(db *gorm.DB) *<%= it.entityName %>Service {
	return &<%= it.entityName %>Service{db: db}
}
<% if (it.scope) { %>

// scoped limits q to the caller's tenant for op ("find", "get", "create",
// "update", "delete") per .apsorc scopeBy, and returns the scope column values.
// Both are unchanged when op is not enforced or the caller holds a bypass role.
func (s *<%= it.entityName %>Service) scoped(ctx context.Context, q *gorm.DB, op string) (*gorm.DB, map[string]string, error) {
	switch op {
	case <%~ it.scope.enforceOn.map((o) => JSON.stringify(o)).join(', ') %>:
	default:
		return q, nil, nil
	}
	a, ok := middleware.FromContext(ctx)
	if !ok {
		return nil, nil, ErrForbidden
	}
<% if (it.scope.bypassRoles.length > 0) { %>
	if hasAnyRole(a.Roles, <%~ it.scope.bypassRoles.map((r) => JSON.stringify(r)).join(', ') %>) {
		return q, nil, nil
	}
<% } %>
	values := map[string]string{
<% it.scope.fields.forEach((f) => { %>
		<%~ JSON.stringify(f.column) %>: a.<%= f.source === 'userId' ? 'UserID' : f.source === 'email' ? 'Email' : 'WorkspaceID' %>,
<% }) %>
	}
	table := models.<%= it.entityName %>{}.TableName()
	for col, v := range values {
		if v == "" {
			return nil, nil, ErrForbidden
		}
		// Compared as text: token claims are strings, the column may be a number or uuid.
		q = q.Where("CAST("+table+"."+col+" AS TEXT) = ?", v)
	}
	return q, values, nil
}
<% } %>

// FindAll retrieves a paginated list of <%= it.pluralName %> with filtering, sorting, and joins.
// Used by the nestjsx dialect ({data,count,total,page,pageCount} envelope).
func (s *<%= it.entityName %>Service) FindAll(ctx context.Context, opts utils.QueryOptions) (*dto.<%= it.entityName %>PaginatedResponse, error) {
	var items []models.<%= it.entityName %>

	query := s.db.WithContext(ctx).Model(&models.<%= it.entityName %>{})
<% it.associations.filter(a => a.eager).forEach((assoc) => { %>
	query = query.Preload("<%= assoc.referenceName || assoc.name %>")
<% }) %>
<% if (it.scope) { %>
	query, _, scopeErr := s.scoped(ctx, query, "find")
	if scopeErr != nil {
		return nil, scopeErr
	}
<% } %>

	query, total, pageCount, err := utils.ApplyQueryE(query, opts, AllowedFields<%= it.entityName %>)
	if err != nil {
		return nil, err
	}

	if err := query.Find(&items).Error; err != nil {
		return nil, err
	}

	response := make([]dto.<%= it.entityName %>Response, len(items))
	for i, item := range items {
		response[i] = s.toResponse(&item)
	}

	return &dto.<%= it.entityName %>PaginatedResponse{
		Data:      response,
		Count:     len(response),
		Total:     total,
		Page:      opts.Page,
		PageCount: pageCount,
	}, nil
}

// FindAllBare retrieves <%= it.pluralName %> as a bare slice (no pagination
// envelope), used by the PostgREST dialect (apso #58). An unknown filter/sort/
// select column surfaces as a *utils.QueryError so the handler answers 400
// rather than 500 (apso #60).
func (s *<%= it.entityName %>Service) FindAllBare(ctx context.Context, opts utils.QueryOptions) ([]dto.<%= it.entityName %>Response, error) {
	var items []models.<%= it.entityName %>

	query := s.db.WithContext(ctx).Model(&models.<%= it.entityName %>{})
<% it.associations.filter(a => a.eager).forEach((assoc) => { %>
	query = query.Preload("<%= assoc.referenceName || assoc.name %>")
<% }) %>
<% if (it.scope) { %>
	query, _, scopeErr := s.scoped(ctx, query, "find")
	if scopeErr != nil {
		return nil, scopeErr
	}
<% } %>

	query, _, _, err := utils.ApplyQueryE(query, opts, AllowedFields<%= it.entityName %>)
	if err != nil {
		return nil, err
	}

	if err := query.Find(&items).Error; err != nil {
		return nil, err
	}

	response := make([]dto.<%= it.entityName %>Response, len(items))
	for i, item := range items {
		response[i] = s.toResponse(&item)
	}
	return response, nil
}

// FindOne retrieves a single <%= it.entityName %> by ID
func (s *<%= it.entityName %>Service) FindOne(ctx context.Context, id string) (*dto.<%= it.entityName %>Response, error) {
	var item models.<%= it.entityName %>

	query := s.db.WithContext(ctx)
<% it.associations.filter(a => a.eager).forEach((assoc) => { %>
	query = query.Preload("<%= assoc.referenceName || assoc.name %>")
<% }) %>
<% if (it.scope) { %>
	query, _, scopeErr := s.scoped(ctx, query, "get")
	if scopeErr != nil {
		return nil, scopeErr
	}
<% } %>

<% if (it.primaryKeyType === 'uuid') { %>
	if err := query.Where("id = ?", id).First(&item).Error; err != nil {
<% } else { %>
	if err := query.First(&item, id).Error; err != nil {
<% } %>
		if errors.Is(err, gorm.ErrRecordNotFound) {
			return nil, errors.New("<%= it.entityName %> not found")
		}
		return nil, err
	}

	response := s.toResponse(&item)
	return &response, nil
}

// Create creates a new <%= it.entityName %>
func (s *<%= it.entityName %>Service) Create(ctx context.Context, input *dto.<%= it.entityName %>Create) (*dto.<%= it.entityName %>Response, error) {
	item := models.<%= it.entityName %>{
<% it.columns.filter(c => !c.generated && !c.primary).forEach((column) => { %>
<% if (column.required) { %>
		<%= column.pascalName %>: input.<%= column.pascalName %>,
<% } else { %>
		<%= column.pascalName %>: input.<%= column.pascalName %>,
<% } %>
<% }) %>
<% it.associations.filter(a => a.type === 'ManyToOne' || (a.type === 'OneToOne' && a.isOwner)).forEach((assoc) => { %>
		<%= assoc.referenceName || assoc.name %>ID: input.<%= assoc.referenceName || assoc.name %>ID,
<% }) %>
	}
<% if (it.scope && it.scope.injectOnCreate) { %>

	// The caller's tenant, never one from the body (.apsorc scopeBy).
	_, scopeVals, scopeErr := s.scoped(ctx, s.db, "create")
	if scopeErr != nil {
		return nil, scopeErr
	}
<% it.scope.fields.forEach((f) => { %>
	if v, ok := scopeVals[<%~ JSON.stringify(f.column) %>]; ok {
		if err := setFromString(&item, <%~ JSON.stringify(f.goField) %>, v); err != nil {
			return nil, err
		}
	}
<% }) %>
<% } %>

	if err := s.db.WithContext(ctx).Create(&item).Error; err != nil {
		return nil, err
	}

	response := s.toResponse(&item)
	return &response, nil
}

// Update updates an existing <%= it.entityName %>
func (s *<%= it.entityName %>Service) Update(ctx context.Context, id string, input *dto.<%= it.entityName %>Update) (*dto.<%= it.entityName %>Response, error) {
	var item models.<%= it.entityName %>

	findQuery := s.db.WithContext(ctx)
<% if (it.scope) { %>
	findQuery, scopeVals, scopeErr := s.scoped(ctx, findQuery, "update")
	if scopeErr != nil {
		return nil, scopeErr
	}
<% } %>
<% if (it.primaryKeyType === 'uuid') { %>
	if err := findQuery.Where("id = ?", id).First(&item).Error; err != nil {
<% } else { %>
	if err := findQuery.First(&item, id).Error; err != nil {
<% } %>
		if errors.Is(err, gorm.ErrRecordNotFound) {
			return nil, errors.New("<%= it.entityName %> not found")
		}
		return nil, err
	}

	updates := make(map[string]interface{})
<% it.columns.filter(c => !c.generated && !c.primary).forEach((column) => { %>
	if input.<%= column.pascalName %> != nil {
		updates["<%= column.snakeName %>"] = *input.<%= column.pascalName %>
	}
<% }) %>
<% it.associations.filter(a => a.type === 'ManyToOne' || (a.type === 'OneToOne' && a.isOwner)).forEach((assoc) => { %>
	if input.<%= assoc.referenceName || assoc.name %>ID != nil {
		updates["<%= assoc.snakeReferenceName || assoc.snakeName %>_id"] = *input.<%= assoc.referenceName || assoc.name %>ID
	}
<% }) %>
<% if (it.scope) { %>
	// A scoped row cannot move to another tenant.
	for col := range scopeVals {
		delete(updates, col)
	}
<% } %>

	if len(updates) > 0 {
		if err := s.db.WithContext(ctx).Model(&item).Updates(updates).Error; err != nil {
			return nil, err
		}
	}

	// Reload with associations
	query := s.db.WithContext(ctx)
<% it.associations.filter(a => a.eager).forEach((assoc) => { %>
	query = query.Preload("<%= assoc.referenceName || assoc.name %>")
<% }) %>
<% if (it.primaryKeyType === 'uuid') { %>
	if err := query.Where("id = ?", id).First(&item).Error; err != nil {
<% } else { %>
	if err := query.First(&item, id).Error; err != nil {
<% } %>
		return nil, err
	}

	response := s.toResponse(&item)
	return &response, nil
}

// Delete removes a <%= it.entityName %> by ID
func (s *<%= it.entityName %>Service) Delete(ctx context.Context, id string) error {
	deleteQuery := s.db.WithContext(ctx)
<% if (it.scope) { %>
	deleteQuery, _, scopeErr := s.scoped(ctx, deleteQuery, "delete")
	if scopeErr != nil {
		return scopeErr
	}
<% } %>
<% if (it.primaryKeyType === 'uuid') { %>
	result := deleteQuery.Where("id = ?", id).Delete(&models.<%= it.entityName %>{})
<% } else { %>
	result := deleteQuery.Delete(&models.<%= it.entityName %>{}, id)
<% } %>
	if result.Error != nil {
		return result.Error
	}
	if result.RowsAffected == 0 {
		return errors.New("<%= it.entityName %> not found")
	}
	return nil
}

// toResponse converts a model to a response DTO
func (s *<%= it.entityName %>Service) toResponse(item *models.<%= it.entityName %>) dto.<%= it.entityName %>Response {
	return dto.<%= it.entityName %>Response{
		ID: item.ID,
<% it.columns.forEach((column) => { %>
		<%= column.pascalName %>: item.<%= column.pascalName %>,
<% }) %>
<% if (it.createdAt) { %>
		CreatedAt: item.CreatedAt,
<% } %>
<% if (it.updatedAt) { %>
		UpdatedAt: item.UpdatedAt,
<% } %>
<% it.associations.filter(a => a.type === 'ManyToOne' || (a.type === 'OneToOne' && a.isOwner)).forEach((assoc) => { %>
		<%= assoc.referenceName || assoc.name %>ID: item.<%= assoc.referenceName || assoc.name %>ID,
<% }) %>
	}
}
