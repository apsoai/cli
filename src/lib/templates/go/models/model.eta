<%~ includeFile('../../header.eta', it) %>

package models
<% if (it.importTime || it.importEnums || it.importPq) { %>

import (
<% if (it.importTime) { %>
	"time"
<% } %>
<% if (it.importEnums) { %>
	"app/autogen/models/enums"
<% } %>
<% if (it.importPq) { %>
	"github.com/lib/pq"
<% } %>
)
<% } %>

// <%= it.name %> represents the <%= it.tableName %> table. Each gorm tag
// matches the column the migrations from `apso migrate` create.
type <%= it.name %> struct {
<% if (it.createPrimaryKey) { %>
<% if (it.primaryKeyType === 'uuid') { %>
	ID string `gorm:"column:id;type:uuid;primaryKey;default:uuid_generate_v4()" json:"id"`
<% } else { %>
	ID uint `gorm:"column:id;type:integer;primaryKey;autoIncrement" json:"id"`
<% } %>
<% } %>
<% it.columns.forEach((column) => { %>
	<%= column.pascalName %> <%~ column.modelGoType %> `gorm:"<%~ column.gormTag %>" json:"<%= column.name %>,omitempty"`
<% }) %>
<% if (it.createdAt) { %>
	CreatedAt time.Time `gorm:"column:created_at;type:timestamp;not null;default:now();autoCreateTime" json:"createdAt"`
<% } %>
<% if (it.updatedAt) { %>
	UpdatedAt time.Time `gorm:"column:updated_at;type:timestamp;not null;default:now();autoUpdateTime" json:"updatedAt"`
<% } %>
<% it.associations.forEach((assoc) => { %>
<% if (assoc.owns) { %>
	<%= assoc.fkField %> <%= assoc.fkGoType %> `gorm:"<%~ assoc.fkTag %>" json:"<%= assoc.camelReferenceName %>Id"`
	<%= assoc.fieldName %> *<%= assoc.name %> `gorm:"foreignKey:<%= assoc.fkField %><% if (assoc.onDeleteCascade) { %>;constraint:OnDelete:CASCADE<% } %>" json:"<%= assoc.jsonName %>,omitempty"`
<% } else if (assoc.type === 'OneToMany') { %>
	<%= assoc.fieldName %> []<%= assoc.name %> `gorm:"foreignKey:<%= assoc.foreignKey %>" json:"<%= assoc.jsonName %>,omitempty"`
<% } else if (assoc.type === 'OneToOne') { %>
	<%= assoc.fieldName %> *<%= assoc.name %> `gorm:"foreignKey:<%= assoc.foreignKey %>;constraint:OnDelete:CASCADE" json:"<%= assoc.jsonName %>,omitempty"`
<% } else if (assoc.type === 'ManyToMany' && assoc.join) { %>
	<%= assoc.fieldName %> []<%= assoc.name %> `gorm:"many2many:<%= assoc.join.name %>;joinForeignKey:<%= assoc.join.ownCol %>;joinReferences:<%= assoc.join.otherCol %>" json:"<%= assoc.jsonName %>,omitempty"`
<% } %>
<% }) %>
}

// TableName overrides the table name
func (<%= it.name %>) TableName() string {
	return "<%= it.tableName %>"
}
