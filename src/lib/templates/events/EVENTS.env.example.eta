<%
const destinations = it.destinations || [];
const installs = {
  kafka: '@nestjs/microservices kafkajs rxjs',
  sqs: '@aws-sdk/client-sqs',
  eventbridge: '@aws-sdk/client-eventbridge',
};
const lines = [];
lines.push('# =============================================================================');
lines.push('# Domain event delivery (autogenerated by Apso)');
lines.push('#');
lines.push('# Delivery is configured ENTIRELY here in the environment — `.apsorc` says');
lines.push('# nothing about it. Adapters for all destinations are generated under');
lines.push('# autogen/events/destinations/; EVENTS_DESTINATION below picks which one(s)');
lines.push('# are actually active at runtime. Broker client libs are loaded lazily, so');
lines.push('# you only install the dependency for the destination(s) you activate.');
lines.push('# =============================================================================');
lines.push('');
lines.push('# Comma-separated list of ACTIVE destinations. Empty = nothing is delivered');
lines.push('# (events stay `pending`). Valid values: ' + destinations.join(', ') + '.');
lines.push('# With more than one, consumers MUST dedupe on event.id (at-least-once,');
lines.push('# re-sends to all on retry).');
lines.push('EVENTS_DESTINATION=webhook');
if (destinations.includes('webhook')) {
  lines.push('');
  lines.push('# --- webhook (Standard Webhooks, https://www.standardwebhooks.com/) ---');
  lines.push('# The single sink URL each event is POSTed to. No extra dependency.');
  lines.push('EVENTS_WEBHOOK_URL=https://example.com/webhooks/domain-events');
  lines.push('# Signing secret in `whsec_<base64>` form.');
  lines.push('EVENTS_WEBHOOK_SECRET=whsec_REPLACE_WITH_BASE64_SECRET');
}
if (destinations.includes('kafka')) {
  lines.push('');
  lines.push('# --- kafka (@nestjs/microservices ClientProxy) ---');
  lines.push('EVENTS_KAFKA_BROKERS=localhost:9092');
  lines.push('EVENTS_KAFKA_TOPIC=domain-events');
}
if (destinations.includes('sqs')) {
  lines.push('');
  lines.push('# --- sqs (@aws-sdk/client-sqs) ---');
  lines.push('AWS_REGION=us-east-1');
  lines.push('EVENTS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/domain-events');
}
if (destinations.includes('eventbridge')) {
  lines.push('');
  lines.push('# --- eventbridge (@aws-sdk/client-eventbridge) ---');
  lines.push('AWS_REGION=us-east-1');
  lines.push('EVENTS_EVENTBRIDGE_BUS=default');
}
const needsInstall = destinations.filter(function (d) { return installs[d]; });
if (needsInstall.length > 0) {
  lines.push('');
  lines.push('# =============================================================================');
  lines.push('# Client libraries — install ONLY for the destination(s) you activate above');
  lines.push('# (install in the generated service, NOT the CLI). webhook needs nothing.');
  needsInstall.forEach(function (d) { lines.push('#   ' + d + ': npm install ' + installs[d]); });
  lines.push('# =============================================================================');
}
%><%~ lines.join('\n') %>
