<% const {field} = it; %>
<% if (field.name === 'created_at') { %>
@CreateDateColumn()
created_at: Date;
<% } else if (field.name === 'updated_at') { %>
@UpdateDateColumn()
updated_at: Date;
<% } else { %>
<% if (field.primary) { %>
@PrimaryColumn({ type: 'timestamp'<% if (field.primaryKeyName) { %>, primaryKeyConstraintName: '<%= field.primaryKeyName %>'<% } %> })
<% } else { %>
<% if (field.index) { %>
@Index()
<% } %>
@Column({ type: 'timestamp', nullable: <%= Boolean(field.nullable) %><% if (field.unique) { %>, unique: true<% } %><% if (field.defaultSql) { %>, default: () => <%~ JSON.stringify(field.defaultSql) %><% } %> })
<% } %>
<%= field.name %>: Date;
<% } %>