<% const {field} = it; %>

<% if (field.primary) { %>
@PrimaryColumn({ "type": "decimal"<% if (field.primaryKeyName) { %>, primaryKeyConstraintName: '<%= field.primaryKeyName %>'<% } %> })
<% } else { %>
@Column({ "type": "decimal", nullable: <%= Boolean(field.nullable) %><% if (field.default !== null) {%>, default:  <%= field.default %><% } %><% if (field.defaultSql) { %>, default: () => <%~ JSON.stringify(field.defaultSql) %><% } %> })
<% if (field.index ) {%>
@Index()
<% } %>
<% } %>
<%= field.name %>: number;