<% const {field} = it; %>

<% if (field.primary) { %>
@PrimaryColumn({
    type: 'enum',
    enum: enums.<%= field.dataType%><% if (field.enumName) { %>,
    enumName: <%~ JSON.stringify(field.enumName) %><% } %><% if (field.primaryKeyName) { %>, primaryKeyConstraintName: '<%= field.primaryKeyName %>'<% } %>
})
<% } else { %>
@Column({
    type: 'enum',
    nullable: <%= Boolean(field.nullable) %>,
    enum: enums.<%= field.dataType%><% if (field.enumName) { %>,
    enumName: <%~ JSON.stringify(field.enumName) %><% } %><% if (field.default !== null) { %>,
    default: enums.<%= field.dataType%>.<%= field.default.toLowerCase().replace(/[^a-z0-9]/g, '_').replace(/^(\d)/, '_$1').replace(/_+/g, '_').replace(/_$/, '') %><% } %>
})
<% if (field.index ) {%>
@Index()
<% } %>
<% } %>

<%= field.name %>!: enums.<%= field.dataType%>;
