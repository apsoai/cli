<% const {field} = it; %>

@Column({ 
  type: "<%= field.elementType || 'text' %>", 
  array: true<% if (field.nullable) {%>, 
  nullable: true<% } %><% if (field.defaultSql) { %>,
  default: () => <%~ JSON.stringify(field.defaultSql) %><% } %> 
})
<% if (field.index ) {%>
@Index()
<% } %>

<%= field.name %>: <%= field.dataType %>;