<% const {field} = it; %>

<% if (field.primary ) {%>
@PrimaryGeneratedColumn('uuid')
<% } else { %>
@Column({ "type": "uuid", nullable: <%= Boolean(field.nullable) %><% if (field.default !== null) {%>, default:  <%= field.default %><% } %> })
<% if (field.index ) {%>
@Index()
<% } %>
<% } %>

<%= field.name %>: string;
