<% const {field} = it; %>

@Column({ "type": "bigint" })
@Generated("increment")
<% if (field.index ) {%>
@Index()
<% } %>
<% if (field.primary ) {%>
@PrimaryColumn(<% if (field.primaryKeyName) { %>{ primaryKeyConstraintName: '<%= field.primaryKeyName %>' }<% } %>)
<% } %>

<%= field.name %>: string; 