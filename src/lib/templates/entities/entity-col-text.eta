<% const {field} = it; %>

@IsOptional({ groups: [UPDATE] })
<% if (!field.nullable && !field.auto) { %>
@IsNotEmpty({ groups: [CREATE] })
<% } %>
<% if (field.is_email) { %>
@IsEmail({ require_tld: false }, { always: true })
<% } %>

<% if (field.auto) { %>
<% /* https://github.com/birkir/prime/issues/126 */ %>
@Generated('increment')
<% }%>
<% if (field.index ) {%>
@Index()
<% } %>
<% if (field.primary) { %>
@PrimaryColumn({ type: "text"<% if (field.primaryKeyName) { %>, primaryKeyConstraintName: '<%= field.primaryKeyName %>'<% } %> })
<% } else { %>
@Column({ type: "text", nullable: <%= Boolean(field.nullable) %><% if (field.unique) {%>, unique: true <% } %><% if (field.default !== null) {%>, default:  '<%= field.default %>'<% } %><% if (field.defaultSql) { %>, default: () => <%~ JSON.stringify(field.defaultSql) %><% } %> })
<% } %>

<%= field.name %>: <%= field.dataType %>;