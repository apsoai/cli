<% const {field} = it; %>

@IsOptional({ groups: [CREATE, UPDATE] })
@IsBoolean({ always: true })

@Column({ type: 'boolean', nullable: <%= Boolean(field.nullable) %><% if (field.defaultSql) { %>, default: () => <%~ JSON.stringify(field.defaultSql) %><% } else if (!field.noDefault) { %>, default: <%= field.default === true || String(field.default).toLowerCase() === 'true' %><% } %> })
<% if (field.index ) {%>
@Index()
<% } %>

<%= field.name %>!: <%= field.dataType %>;