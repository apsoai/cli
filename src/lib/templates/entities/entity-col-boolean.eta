<% const {field} = it; %>

@IsOptional({ groups: [CREATE, UPDATE] })
@IsBoolean({ always: true })

@Column({ type: 'boolean', nullable: <%= Boolean(field.nullable) %>, default: <%= field.default === true || String(field.default).toLowerCase() === 'true' %> })
<% if (field.index ) {%>
@Index()
<% } %>

<%= field.name %>!: <%= field.dataType %>;