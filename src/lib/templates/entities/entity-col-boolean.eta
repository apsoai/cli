<% const {field} = it; %>

@IsOptional({ groups: [CREATE, UPDATE] })
@IsBoolean({ always: true })

@Column({ type: 'boolean', nullable: <%= Boolean(field.nullable) %>, default: <%= Boolean(field.default) || false %> })
<% if (field.index ) {%>
@Index()
<% } %>

<%= field.name %>!: <%= field.dataType %>;