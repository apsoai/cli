<% const {field} = it; %>

<% if (field.primary) { %>
@PrimaryColumn({ type: 'date'<% if (field.primaryKeyName) { %>, primaryKeyConstraintName: '<%= field.primaryKeyName %>'<% } %> })
<% } else { %>
<% if (field.index) { %>
@Index()
<% } %>
@Column({ type: 'date', nullable: <%= Boolean(field.nullable) %><% if (field.unique) { %>, unique: true<% } %> })
<% } %>

<%= field.name %>: string;