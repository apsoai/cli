<%~ includeFile('./header.eta') %>

<% it.entities.forEach((entity) => { %>
import {<%= entity.name %>Module} from './<%= entity.name %>/<%= entity.name %>.module'
<%}) %>
<% if (it.guards) { %>
import { GuardsModule } from './guards/guards.module'
<% } %>
<% if (it.schemaExtras) { %>
import { SchemaExtrasModule } from './schema-extras.module'
<% } %>

export default [
<% it.entities.forEach((entity) => { %>
<%= entity.name %>Module,
<%}) %>
<% if (it.guards) { %>
GuardsModule,
<% } %>
<% if (it.schemaExtras) { %>
SchemaExtrasModule,
<% } %>
]

// The OpenAPI info.description: who signs callers in, how records are scoped
// and which operations need which role (from .apsorc).
export const apiDescription = <%~ JSON.stringify(it.apiDescription) %>;
