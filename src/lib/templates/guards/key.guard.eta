/**
 * ApiKeyGuard - the API key check built into every Apso service
 *
 * Auto-generated by Apso CLI. Not configurable in .apsorc.
 *
 * The key source is chosen once, when the service starts, first match wins:
 * 1. APSO_API_KEY is set: the x-api-key header must match it. The variable
 *    holds the key itself (not a hash); several keys separated by commas are
 *    accepted, so a key can be rotated without downtime.
 * 2. APSO_SERVICE_TOKEN_JWKS_URL is set: the platform's gateway has checked
 *    the key and sends a signed token in x-apso-service-token.
 * 3. Neither: API keys are off and only signed-in users are accepted. A
 *    service with no sign-in configured then refuses every request.
 *
 * A caller with a valid key is a service caller (request.auth.serviceId): it
 * may call any route, is not tenant-scoped and skips role permission checks.
 * A request whose key fails is refused, whatever else it carries.
 *
 * For logging, the guards record who is calling on request.apso.caller and
 * why a request was refused on request.apso.denied.
 *
 * DO NOT EDIT - Changes will be overwritten on next scaffold
 */
import {
  Injectable,
  CanActivate,
  ExecutionContext,
<% if (it.authRoutes.length > 0) { %>
  ForbiddenException,
<% } %>
  UnauthorizedException,
} from '@nestjs/common';
import { Reflector } from '@nestjs/core';
import { createHash, randomUUID, timingSafeEqual } from 'crypto';
import { createRemoteJWKSet, jwtVerify } from 'jose';
<% if (it.hasAuth) { %>
import { AuthGuard, IS_PUBLIC_KEY<% if (it.mcpAuth) { %>, MCP_SIGN_IN<% } %> } from './auth.guard';
<% } else if (it.scopedEntities.length > 0) { %>
import { IS_PUBLIC_KEY } from './scope.guard';
<% } else { %>

export const IS_PUBLIC_KEY = 'isPublic';

/**
 * Decorator to mark a route as public (skips the key check)
 * Usage: @Public()
 */
export const Public =
  () => (target: any, key?: string, descriptor?: PropertyDescriptor) => {
    Reflect.defineMetadata(IS_PUBLIC_KEY, true, descriptor?.value || target);
  };
<% } %>

/** What request.auth holds for a caller that presented a valid API key. */
export interface ServiceCaller {
  /** The key's id: from the platform, or the first 8 hex digits of its SHA-256. */
  serviceId: string;
  roles: string[];
  permissions: string[];
}

const NO_SOURCE =
  'This service has no API key source and no sign-in configured, so it refuses every request. Set APSO_API_KEY in its environment; "apso dev" creates a development key in .env.';
const NO_CREDENTIAL = 'No credential on the request. Send the API key in the x-api-key header.';
const WRONG_KEY = 'The key in the x-api-key header does not match APSO_API_KEY.';
const NO_SERVICE_TOKEN =
  'This service takes API keys through the platform gateway, and the request has no valid x-apso-service-token. Call the service at its gateway URL with a key issued for it.';
const KEYS_OFF = 'An x-api-key header was sent, but API keys are off on this service. Set APSO_API_KEY to turn them on.';

const sha256 = (value: string) => createHash('sha256').update(value).digest();
<% if (it.authRoutes.length > 0) { %>

/**
 * The auth entities hold session tokens, password hashes, reset tokens and
 * each user's tenant and role, so only a service caller reaches their routes;
 * a signed-in user gets a 403. No other entity's controller joins onto them.
 */
const AUTH_ENTITY_ROUTES = new Set([<%~ it.authRoutes.map((r) => `'${r}'`).join(', ') %>]);
<% } %>

@Injectable()
export class ApiKeyGuard implements CanActivate {
  private readonly keys: Buffer[];
  private readonly jwks?: ReturnType<typeof createRemoteJWKSet>;
  private readonly issuer = process.env.APSO_SERVICE_TOKEN_ISSUER;
  private readonly serviceId = process.env.APSO_SERVICE_ID;
  // The detailed 401 is for a developer's machine only: "apso dev" sets
  // APSO_LOCAL, and Lambda ignores it.
  private readonly local = process.env.APSO_LOCAL === '1' && !process.env.AWS_LAMBDA_FUNCTION_NAME;

  constructor(
    private reflector: Reflector,
<% if (it.hasAuth) { %>
    private authGuard: AuthGuard,
<% } %>
  ) {
    this.keys = (process.env.APSO_API_KEY || '')
      .split(',')
      .map((key) => key.trim())
      .filter(Boolean)
      .map(sha256);
    const jwksUrl = process.env.APSO_SERVICE_TOKEN_JWKS_URL;
    if (this.keys.length > 0) {
      console.log(`[apso] API keys: checked against APSO_API_KEY (${this.keys.length} set)`);
    } else if (jwksUrl) {
      this.jwks = createRemoteJWKSet(new URL(jwksUrl));
      console.log('[apso] API keys: checked by the platform gateway (APSO_SERVICE_TOKEN_JWKS_URL)');
      if (!this.issuer || !this.serviceId) {
        console.warn('[apso] WARNING: APSO_SERVICE_TOKEN_ISSUER and APSO_SERVICE_ID must both be set; until then every API key is refused.');
      }
    } else {
      console.log('[apso] API keys: off (neither APSO_API_KEY nor APSO_SERVICE_TOKEN_JWKS_URL is set)');
<% if (!it.hasAuth) { %>
      console.warn(`[apso] WARNING: ${NO_SOURCE}`);
<% } %>
    }
  }

  async canActivate(context: ExecutionContext): Promise<boolean> {
    const http = context.switchToHttp();
    const request = http.getRequest();
    http.getResponse().setHeader('x-request-id', this.requestId(request));

    const isPublic = this.reflector.getAllAndOverride<boolean>(IS_PUBLIC_KEY, [
      context.getHandler(),
      context.getClass(),
    ]);
    // The template's health check stays public for load balancer probes.
    if (isPublic || (request.method === 'GET' && /^\/health\/?$/.test(request.path))) {
      return true;
    }

    if (await this.serviceCaller(request)) {
      return true;
    }
<% if (it.hasAuth) { %>
    // No key on the request: the caller has to be a signed-in user.
    try {
      await this.authGuard.canActivate(context);
    } catch (error) {
      if (error instanceof UnauthorizedException) {
        this.refuse(
          request,
          `${error.message}. Send a signed-in user's token, or an API key in the x-api-key header.`,
          error.message.toLowerCase(),
        );
      }
      throw error;
    }
<% if (it.authRoutes.length > 0) { %>
    const route = String(request.route?.path || request.path).match(/^\/([^\/]+)/)?.[1];
    if (route && AUTH_ENTITY_ROUTES.has(route.toLowerCase())) {
      // The log line names the signed-in user that was refused.
      this.userCaller(request);
      request.apso = { ...request.apso, denied: 'auth entity, service callers only' };
      throw new ForbiddenException('This route is for service callers only');
    }
<% } %>
    return this.userCaller(request);
<% } else { %>
    if (this.keys.length > 0 || this.jwks) {
      this.refuse(request, NO_CREDENTIAL, 'no credential');
    }
    this.refuse(request, NO_SOURCE, 'no key source');
<% } %>
  }
<% if (it.mcpAuth) { %>

  /** The same check for a request outside the guard chain (the /mcp endpoint). */
  async authenticate(request: any): Promise<unknown> {
    this.requestId(request);
    if (await this.serviceCaller(request)) {
      return request.auth;
    }
    const auth = await this.authGuard.authenticate(request);
    this.userCaller(request);
    return auth;
  }
<% } %>
<% if (it.hasAuth) { %>

  /** Record the signed-in user AuthGuard attached as the request's caller. */
  private userCaller(request: any): true {
    const auth = request.auth ?? {};
    const clientId = auth.claims?.azp ?? auth.claims?.client_id;
    request.apso = {
      ...request.apso,
      caller: { type: 'user', userId: auth.userId, tenantId: auth.workspaceId, ...(clientId ? { clientId } : {}) },
    };
    return true;
  }
<% } %>

  /**
   * True when the request carries a valid key, false when it presents none.
   * A key that fails the chosen source is refused here; no other source and
   * no user token is tried.
   */
  private async serviceCaller(request: any): Promise<boolean> {
    const key = request.headers['x-api-key'];
    let serviceId: string | undefined;
    if (this.keys.length > 0) {
      if (!key) return false;
      const digest = sha256(String(key));
      // Every key is compared, in constant time.
      const [match] = this.keys.filter((candidate) => timingSafeEqual(candidate, digest));
      if (!match) this.refuse(request, WRONG_KEY, 'api key not recognised');
      serviceId = match.toString('hex').slice(0, 8);
    } else if (this.jwks) {
      const token = request.headers['x-apso-service-token'];
      if (!key && !token) return false;
      serviceId = token ? await this.verifyServiceToken(String(token)) : undefined;
      if (!serviceId) this.refuse(request, NO_SERVICE_TOKEN, 'no valid service token');
    } else {
      if (!key) return false;
      this.refuse(request, KEYS_OFF, 'api keys are off');
    }
    const caller: ServiceCaller = { serviceId: serviceId as string, roles: [], permissions: [] };
    request.auth = caller;
    // The key's id, never the key.
    request.apso = { ...request.apso, caller: { type: 'service', keyId: caller.serviceId } };
    return true;
  }

  /** The key id from the gateway's token (sub "apikey:<id>"), when the token is valid for this service. */
  private async verifyServiceToken(token: string): Promise<string | undefined> {
    if (!this.jwks || !this.issuer || !this.serviceId) return undefined;
    try {
      const { payload } = await jwtVerify(token, this.jwks, {
        issuer: this.issuer,
        audience: this.serviceId,
        algorithms: ['ES256'],
        requiredClaims: ['exp', 'sub'],
      });
      const id = /^apikey:(.+)$/.exec(payload.sub as string)?.[1];
      return id;
    } catch {
      return undefined;
    }
  }

  /**
   * The request id: the logging library's (request.apso.requestId) when it is
   * installed, else the caller's x-request-id, else a new one.
   */
  private requestId(request: any): string {
    const sent = request.apso?.requestId ?? request.headers['x-request-id'];
    const id = typeof sent === 'string' && sent ? sent : randomUUID();
    request.headers['x-request-id'] = id;
    return id;
  }

  /** 401. The reason goes to the log, and to the caller only on a developer's machine. */
  private refuse(request: any, reason: string, denied: string): never {
    const requestId = request.headers['x-request-id'];
    request.apso = { ...request.apso, denied };
    console.warn(`[apso] 401 ${request.method} ${String(request.url).split('?')[0]} request=${requestId}: ${reason}`);
    throw new UnauthorizedException({
      statusCode: 401,
      message: this.local ? reason : 'Unauthorized',
      requestId,
    });
  }
}
<% if (it.mcpAuth) { %>

/**
 * Sign-in settings @apso/mcp reads (its MCP_AUTH token). An MCP client that
 * calls /mcp without a valid token or key is pointed at the identity
 * provider, and every MCP request meets the same check as the REST API.
 */
export const McpAuthProvider = {
  provide: 'APSO_MCP_AUTH',
  inject: [ApiKeyGuard],
  useFactory: (guard: ApiKeyGuard) => ({
    ...MCP_SIGN_IN,
    verify: (request: any) => guard.authenticate(request),
  }),
};
<% } %>
