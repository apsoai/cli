<%~ includeFile('../header.eta') %>

import {
  BadRequestException,
  ConflictException,
  Injectable,
  CanActivate,
  ExecutionContext,
  ForbiddenException,
} from '@nestjs/common';
import { Reflector } from '@nestjs/core';
import { InjectRepository } from '@nestjs/typeorm';
import { DataSource, Repository } from 'typeorm';

<% /* Import all entities that have scoped relationships (from sibling autogen folders) */ %>
<% it.scopedEntities.forEach((entity) => { %>
import { <%= entity.name %> } from '../<%= entity.name %>/<%= entity.name %>.entity';
<% }) %>

/**
 * Decorator to skip scope check for certain routes
 */
export const SKIP_SCOPE_CHECK = 'skipScopeCheck';
export const SkipScopeCheck = () =>
  (target: any, key?: string, descriptor?: PropertyDescriptor) => {
    Reflect.defineMetadata(
      SKIP_SCOPE_CHECK,
      true,
      descriptor?.value || target,
    );
  };

<% if (it.hasAuth) { %>
/**
 * Import Public decorator from auth.guard to avoid duplicate exports
 */
import { IS_PUBLIC_KEY, Public } from './auth.guard';
export { IS_PUBLIC_KEY, Public };
<% } else { %>
/**
 * Decorator to mark routes as public (no auth required)
 */
export const IS_PUBLIC_KEY = 'isPublic';
export const Public = () =>
  (target: any, key?: string, descriptor?: PropertyDescriptor) => {
    Reflect.defineMetadata(
      IS_PUBLIC_KEY,
      true,
      descriptor?.value || target,
    );
  };
<% } %>

/**
 * Scope configuration for each entity
 * Generated from .apsorc scopeBy definitions
 */
export interface ScopeConfig {
  /** The scope fields or paths (e.g., 'workspaceId' or 'task.workspaceId') */
  scopes: ScopeField[];
  /** Whether to inject scope on create */
  injectOnCreate: boolean;
  /** Which operations to enforce scope on */
  enforceOn: string[];
  /** Roles that can bypass scope enforcement */
  bypassRoles: string[];
}

export interface ScopeField {
  /** The field name on the entity (e.g., 'workspaceId') or first segment of path */
  field: string;
  /** The context key to get the value from (defaults to field name) */
  contextKey: string;
  /** Whether this is a direct field (true) or nested path (false) */
  direct: boolean;
  /** For nested paths, the full path (e.g., 'task.workspaceId') */
  path?: string;
  /** Nested paths: the foreign key to the first hop (e.g., 'taskId') */
  fkField?: string;
  /** Nested paths: the entity the foreign key points to (e.g., 'Task') */
  parentEntity?: string;
  /** Nested paths: the rest of the path on that entity (e.g., 'workspaceId') */
  parentPath?: string;
}

/**
 * Entity scope configuration map
 * Auto-generated from .apsorc
 */
export const ENTITY_SCOPES: Record<string, ScopeConfig> = {
<% it.scopedEntities.forEach((entity, index) => { %>
  '<%= entity.routeName %>': {
    scopes: [
<% entity.scopes.forEach((scope, scopeIndex) => { %>
      {
        field: '<%= scope.field %>',
        contextKey: '<%= scope.contextKey %>',
        direct: <%= scope.direct %>,
<% if (scope.path) { %>
        path: '<%= scope.path %>',
<% } %>
<% if (scope.fkField) { %>
        fkField: '<%= scope.fkField %>',
        parentEntity: '<%= scope.parentEntity %>',
        parentPath: '<%= scope.parentPath %>',
<% } %>
      }<%= scopeIndex < entity.scopes.length - 1 ? ',' : '' %>
<% }) %>
    ],
    injectOnCreate: <%= entity.injectOnCreate %>,
    enforceOn: [<%~ entity.enforceOn.map(op => `'${op}'`).join(', ') %>],
    bypassRoles: [<%~ entity.bypassRoles.map(role => `'${role}'`).join(', ') %>],
  }<%= index < it.scopedEntities.length - 1 ? ',' : '' %>
<% }) %>
};

/**
 * Every entity by its route, so a write body can be checked against the
 * entity's relations whether or not the entity itself is scoped.
 */
export const ROUTE_ENTITIES: Record<string, string> = {
<% it.routeEntities.forEach((entity) => { %>
  '<%= entity.route %>': '<%= entity.name %>',
<% }) %>
};
const ENTITY_ROUTES: Record<string, string> = Object.fromEntries(
  Object.entries(ROUTE_ENTITIES).map(([route, name]) => [name, route]),
);

@Injectable()
export class ScopeGuard implements CanActivate {
  constructor(
    private reflector: Reflector,
<% it.scopedEntities.forEach((entity) => { %>
    @InjectRepository(<%= entity.name %>)
    private <%= entity.repoName %>: Repository<<%= entity.name %>>,
<% }) %>
    private dataSource: DataSource,
  ) {}

  async canActivate(context: ExecutionContext): Promise<boolean> {
    try {
      return await this.check(context);
    } catch (error) {
      if (error instanceof ForbiddenException) {
        // The reason, for the log.
        const request = context.switchToHttp().getRequest();
        const denied = /tenant/.test(error.message) ? 'no tenant' : 'outside the tenant scope';
        request.apso = { ...request.apso, denied };
      }
      throw error;
    }
  }

  private async check(context: ExecutionContext): Promise<boolean> {
    // Check if route should skip scope check
    const skipCheck = this.reflector.getAllAndOverride<boolean>(
      SKIP_SCOPE_CHECK,
      [context.getHandler(), context.getClass()],
    );

    if (skipCheck) {
      return true;
    }

    // Check if route is public
    const isPublic = this.reflector.getAllAndOverride<boolean>(IS_PUBLIC_KEY, [
      context.getHandler(),
      context.getClass(),
    ]);

    if (isPublic) {
      return true;
    }

    const request = context.switchToHttp().getRequest();

    // A service caller (valid API key) is not tenant-scoped.
    if (request.auth?.serviceId) {
      return true;
    }

    // Get the resource path from the request
    const path = request.route?.path || request.path;
    const method = request.method;

    // Extract entity type from path (e.g., /Projects/:id -> projects)
    const entityMatch = path.match(/^\/([^\/]+)/);
    if (!entityMatch) {
      return true;
    }

    const entityType = entityMatch[1].toLowerCase();

    // Check if this is a scoped entity
    const scopeConfig = ENTITY_SCOPES[entityType];
    const writes = method === 'POST' || method === 'PUT' || method === 'PATCH';
    if (!scopeConfig) {
      // Not a scoped entity; its body still must not reach a scoped row.
      if (writes) {
        await this.checkBody(request, entityType);
      }
      return true;
    }

    // Check if user has bypass role
    const userRoles: string[] = request.auth?.roles ?? request.user?.roles ?? request.roles ?? [];
    if (scopeConfig.bypassRoles.some(role => userRoles.includes(role))) {
      return true;
    }

    // Whatever enforceOn says for this entity, a body must not reach another
    // entity's rows or write over an existing row.
    if (writes) {
      await this.checkBody(request, entityType, scopeConfig);
    }

    // Map HTTP method to operation
    const operation = this.mapMethodToOperation(method, request.params?.id);

    // Check if this operation should be enforced
    if (!scopeConfig.enforceOn.includes(operation)) {
      return true;
    }
<% if (it.hasNestedFk) { %>

    // Nested paths (task.workspaceId): load the caller's parent ids for the
    // controller's list filter, and refuse a parent from another tenant.
    await this.loadNestedScopes(request, scopeConfig, operation);
<% } %>

    // For GET requests with an ID, verify the resource belongs to this scope
    if ((operation === 'get' || operation === 'update' || operation === 'delete') && request.params?.id) {
      const hasAccess = await this.verifyResourceAccess(
        entityType,
        request.params.id,
        request,
        scopeConfig,
      );
      if (!hasAccess) {
        throw new ForbiddenException('You do not have access to this resource');
      }
    }

    // For POST requests, inject scope values if configured
    if (operation === 'create' && scopeConfig.injectOnCreate) {
      this.injectScopeValues(request, scopeConfig);
    }
<% if (it.hasAuth) { %>

    // A scoped row cannot move to another tenant on update.
    if (operation === 'update') {
      this.injectScopeValues(request, scopeConfig);
    }
<% } %>

    // For GET (list) requests, add scope filter
    if (operation === 'find') {
      this.addScopeFilter(request, scopeConfig);
    }

    return true;
  }

  private mapMethodToOperation(method: string, hasId: boolean): string {
    switch (method) {
      case 'GET':
        return hasId ? 'get' : 'find';
      case 'POST':
        return 'create';
      case 'PUT':
      case 'PATCH':
        return 'update';
      case 'DELETE':
        return 'delete';
      default:
        return 'find';
    }
  }

  private async verifyResourceAccess(
    entityType: string,
    resourceId: string,
    request: any,
    scopeConfig: ScopeConfig,
  ): Promise<boolean> {
    try {
      const repo = this.getRepository(entityType);
      if (!repo) {
        return true; // Unknown entity, allow through
      }

      // Build relations array for nested scopes
      const relations: string[] = [];
      for (const scope of scopeConfig.scopes) {
        if (!scope.direct && scope.path) {
          // Extract relation name from path (e.g., 'task.workspaceId' -> 'task')
          const relationName = scope.path.split('.')[0];
          if (!relations.includes(relationName)) {
            relations.push(relationName);
          }
        }
      }

      const entity = await repo.findOne({
        where: { id: resourceId },
        relations,
      });

      if (!entity) {
        return false;
      }

      // Verify all scope conditions
      for (const scope of scopeConfig.scopes) {
        const expectedValue = this.getScopeValue(request, scope.contextKey);
        if (!expectedValue) {
<% if (it.hasAuth) { %>
          return false; // The caller has no tenant, so it owns no scoped rows
<% } else { %>
          continue; // No scope value in context, skip this check
<% } %>
        }

        let actualValue: any;
        if (scope.direct) {
          actualValue = (entity as any)[scope.field];
        } else if (scope.path) {
          // Navigate the path (e.g., 'task.workspaceId')
          actualValue = this.getNestedValue(entity, scope.path);
        }

        // Token claims are strings; a numeric FK column reads back as a number.
        if (actualValue == null || String(actualValue) !== String(expectedValue)) {
          return false;
        }
      }

      return true;
    } catch (error) {
      console.error('Scope verification error:', error);
      return false;
    }
  }

  private injectScopeValues(request: any, scopeConfig: ScopeConfig): void {
    for (const scope of scopeConfig.scopes) {
      if (scope.direct) {
        const scopeValue = this.getScopeValue(request, scope.contextKey);
<% if (it.hasAuth) { %>
        if (!scopeValue) {
          throw new ForbiddenException('No tenant in the auth context');
        }
        // Always the caller's tenant, never one from the body.
        for (const item of this.bodyItems(request.body)) {
          item[scope.field] = scopeValue;
        }
<% } else { %>
        for (const item of this.bodyItems(request.body)) {
          if (scopeValue && !item[scope.field]) {
            item[scope.field] = scopeValue;
          }
        }
<% } %>
      }
    }
  }

  /** The rows a write body carries: the body itself and each row of a bulk create. */
  private bodyItems(body: any): any[] {
    const plain = (v: any) => v !== null && typeof v === 'object' && !Array.isArray(v);
    if (!plain(body)) {
      return [];
    }
    return [body, ...(Array.isArray(body.bulk) ? body.bulk.filter(plain) : [])];
  }

  /**
   * Relations and ids in a write body. TypeORM saves a relation object in
   * place of the foreign key column, saves the rows listed under a to-many
   * relation, and updates the row a body names by id. So before the
   * checks below run:
   * - the body's own id is dropped: the database assigns it on create, and
   *   on update the row is the one the route names. A key the client chooses
   *   is kept on create, and refused when a row already has it
   * - a to-one relation becomes its foreign key, which is then checked like
   *   any other column
   * - rows of a scoped entity listed under a relation must be the caller's
   *   own, and only their ids are kept
   */
  private async checkBody(
    request: any,
    entityType: string,
    scopeConfig?: ScopeConfig,
  ): Promise<void> {
    if (Array.isArray(request.body)) {
      throw new BadRequestException('The body must be an object');
    }
    const name = ROUTE_ENTITIES[entityType];
    if (!name) {
      return;
    }
    const metadata = this.dataSource.getMetadata(name);
    const scopeFields = (scopeConfig?.scopes ?? []).map((s) => s.fkField ?? s.field);
    const denied = () => new ForbiddenException('You do not have access to this resource');

    for (const item of this.bodyItems(request.body)) {
      if (scopeConfig) {
        const chosen: Record<string, any> = {};
        for (const column of metadata.primaryColumns) {
          const sent = item[column.propertyName];
          if (column.isGenerated || request.method !== 'POST') {
            delete item[column.propertyName];
          } else if (sent != null) {
            chosen[column.propertyName] = sent;
          }
        }
        // A key the client chooses: a create must not write over the row that has it.
        if (Object.keys(chosen).length > 0) {
          if (Object.values(chosen).some((v) => typeof v === 'object')) throw denied();
          if (await this.dataSource.getRepository(name).findOne({ where: chosen })) {
            throw new ConflictException('A row with this key already exists');
          }
        }
      }
      for (const relation of metadata.relations) {
        const key = relation.propertyName;
        if (!Object.prototype.hasOwnProperty.call(item, key)) continue;
        const value = item[key];
        const target = relation.inverseEntityMetadata;
        const targetRoute = ENTITY_ROUTES[target.name];
        const targetScope = ENTITY_SCOPES[targetRoute];
        const isObject = value !== null && typeof value === 'object';

        const [join] = relation.joinColumns;
        if ((relation.isManyToOne || relation.isOneToOneOwner) && relation.joinColumns.length === 1) {
          if (!targetScope && !scopeFields.includes(join.propertyName)) continue;
          const referenced = join.referencedColumn!.propertyName;
          const id = isObject ? (Array.isArray(value) ? undefined : value[referenced]) : value;
          if (id !== null && typeof id === 'object') throw denied();
          if (join.isVirtual) {
            // No column property to move the id to: keep the id alone.
            item[key] = id == null ? null : { [referenced]: id };
          } else {
            delete item[key];
            if (id !== undefined) item[join.propertyName] = id;
          }
          continue;
        }

        // A to-many (or inverse one-to-one) relation: saving it writes the listed rows.
        if (!targetScope) continue;
        // A shared row cannot take over or let go of scoped rows.
        if (!scopeConfig) throw denied();
        const primary = target.primaryColumns[0].propertyName;
        const kept: any[] = [];
        for (const row of Array.isArray(value) ? value : value == null ? [] : [value]) {
          const id = row !== null && typeof row === 'object' ? row[primary] : row;
          if (id == null || typeof id === 'object') throw denied();
          if (!(await this.verifyResourceAccess(targetRoute, String(id), request, targetScope))) throw denied();
          kept.push({ [primary]: id });
        }
        item[key] = Array.isArray(value) ? kept : kept[0] ?? null;
      }
    }
  }

  private addScopeFilter(request: any, scopeConfig: ScopeConfig): void {
    if (!request.query) {
      request.query = {};
    }

    for (const scope of scopeConfig.scopes) {
      if (scope.direct) {
        const scopeValue = this.getScopeValue(request, scope.contextKey);
<% if (it.hasAuth) { %>
        if (!scopeValue) {
          throw new ForbiddenException('No tenant in the auth context');
        }
<% } %>
        if (scopeValue) {
          // Add filter for @apso/crud
          request.query[`filter.${scope.field}`] = `$eq:${scopeValue}`;
        }
      }
    }
  }

  private getScopeValue(request: any, contextKey: string): string | undefined {
    // Try multiple locations for the scope value
    return (
      request[contextKey] ||
      request.user?.[contextKey] ||
      request.scope?.[contextKey] ||
      request.context?.[contextKey]<% if (it.hasAuth) { %> ||
      // A scope field with another name (orgId, tenantId) is the caller's tenant.
      request.auth?.[contextKey] ||
      request.auth?.workspaceId<% } %>
    );
  }

<% if (it.hasNestedFk) { %>
  /**
   * For each nested scope, find the ids of the parent rows in the caller's
   * tenant and put them on request.apsoScope, where the controller's
   * @CrudAuth filter reads them. A create or update that names a parent
   * outside that set is refused.
   */
  private async loadNestedScopes(
    request: any,
    scopeConfig: ScopeConfig,
    operation: string,
  ): Promise<void> {
    for (const scope of scopeConfig.scopes) {
      if (!scope.fkField || !scope.parentEntity || !scope.parentPath) continue;
      const scopeValue = this.getScopeValue(request, scope.contextKey);
      if (!scopeValue) {
        throw new ForbiddenException('No tenant in the auth context');
      }
      // ponytail: loads every parent id in the tenant per request; switch to a
      // subquery filter if a tenant grows past tens of thousands of parents.
      const repo = this.dataSource.getRepository(scope.parentEntity);
      const pk = repo.metadata.primaryColumns[0].propertyName;
      const where = scope.parentPath
        .split('.')
        .reverse()
        .reduce<any>((inner, key) => ({ [key]: inner }), scopeValue);
      const parents = await repo.find({ select: { [pk]: true } as any, where });
      const ids = parents.map((p: any) => p[pk]);
      request.apsoScope = { ...request.apsoScope, [scope.fkField]: ids };

      if (operation === 'create' || operation === 'update') {
        // checkBody has already turned a relation object into this foreign key.
        for (const item of this.bodyItems(request.body)) {
          const fk = item[scope.fkField];
          if (fk != null && !ids.some((id: any) => String(id) === String(fk))) {
            throw new ForbiddenException('You do not have access to this resource');
          }
        }
      }
    }
  }

<% } %>
  private getNestedValue(obj: any, path: string): any {
    return path.split('.').reduce((current, key) => current?.[key], obj);
  }

  private getRepository(entityType: string): Repository<any> | null {
    switch (entityType) {
<% it.scopedEntities.forEach((entity) => { %>
      case '<%= entity.routeName %>':
        return this.<%= entity.repoName %>;
<% }) %>
      default:
        return null;
    }
  }
}
