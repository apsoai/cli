<%~ includeFile('../header.eta') %>

import { Module, Global } from '@nestjs/common';
import { TypeOrmModule } from '@nestjs/typeorm';
import { APP_GUARD } from '@nestjs/core';

<% if (it.scopedEntities && it.scopedEntities.length > 0) { %>
import { ScopeGuard } from './scope.guard';
<% } %>
import { ApiKeyGuard<% if (it.mcpAuth) { %>, McpAuthProvider<% } %> } from './key.guard';
<% if (it.hasAuth) { %>
import { AuthGuard } from './auth.guard';
<% } %>
<% if (it.permissions) { %>
import { PermissionGuard } from './permission.guard';
<% } %>

<% /* Import all entities for ScopeGuard (from sibling autogen folders) */ %>
<% if (it.scopedEntities && it.scopedEntities.length > 0) { %>
// Entities for ScopeGuard
<% it.scopedEntities.forEach((entity) => { %>
import { <%= entity.name %> } from '../<%= entity.name %>/<%= entity.name %>.entity';
<% }) %>
<% } %>

/**
 * GuardsModule turns on the service's global guards. Every request is refused
 * unless a guard lets it through; a route opts out with @Public().
 *
 * Auto-generated from .apsorc configuration.
 *
 * ApiKeyGuard (in every service):
 * - Checks the x-api-key header against the key source chosen at start-up
 *   (APSO_API_KEY, else the platform gateway's service token, else off)
 * - A caller with a valid key is a service caller: any route, no tenant scope
<% if (it.hasAuth) { %>
 * - A request with no key goes to AuthGuard (<%= it.authProvider %>), which
 *   attaches the signed-in user's AuthContext to request.auth
<% } else { %>
 * - No sign-in is configured (.apsorc has no auth block), so a request with no
 *   valid key is refused
<% } %>
 *
<% if (it.scopedEntities && it.scopedEntities.length > 0) { %>
 * ScopeGuard:
 * - Enforces data isolation based on scopeBy config
 * - POST requests auto-inject scope fields from request.auth
 * - GET requests auto-filter by scope fields
 * - GET/PUT/PATCH/DELETE by ID verify resource ownership
 *
<% } %>
 * Decorators:
 * - @Public() - Skip all guards for a route
<% if (it.scopedEntities && it.scopedEntities.length > 0) { %>
 * - @SkipScopeCheck() - Skip only scope checking
<% } %>
 */
@Global()
@Module({
  imports: [
    TypeOrmModule.forFeature([
<% /* Collect all unique entities */ %>
<% const allEntities = new Set(); %>
<% if (it.scopedEntities) { it.scopedEntities.forEach(e => allEntities.add(e.name)); } %>
<% const entityArray = Array.from(allEntities); %>
<% entityArray.forEach((entity, index) => { %>
      <%= entity %><%= index < entityArray.length - 1 ? ',' : '' %>
<% }) %>
    ]),
  ],
  providers: [
    ApiKeyGuard,
<% if (it.hasAuth) { %>
    AuthGuard,
<% } %>
<% if (it.mcpAuth) { %>
    McpAuthProvider,
<% } %>
<% if (it.permissions) { %>
    PermissionGuard,
<% } %>
<% if (it.scopedEntities && it.scopedEntities.length > 0) { %>
    ScopeGuard,
<% } %>
    // Global guards, in the order they run. ApiKeyGuard checks an API key and
    // hands a request without one to AuthGuard when sign-in is configured.
    {
      provide: APP_GUARD,
      useExisting: ApiKeyGuard,
    },
<% if (it.permissions) { %>
    // Global guards run in this order: roles are checked after the caller is
    // known and before the scope guard loads any rows.
    {
      provide: APP_GUARD,
      useClass: PermissionGuard,
    },
<% } %>
<% if (it.scopedEntities && it.scopedEntities.length > 0) { %>
    {
      provide: APP_GUARD,
      useClass: ScopeGuard,
    },
<% } %>
  ],
  exports: [
    ApiKeyGuard,
<% if (it.hasAuth) { %>
    AuthGuard,
<% } %>
<% if (it.permissions) { %>
    PermissionGuard,
<% } %>
<% if (it.scopedEntities && it.scopedEntities.length > 0) { %>
    ScopeGuard,
<% } %>
  ],
})
export class GuardsModule {}
