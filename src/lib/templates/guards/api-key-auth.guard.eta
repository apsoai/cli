/**
 * AuthGuard - application API keys stored as SHA-256 hashes on <%= it.apiKey.apiKeyEntity %>
 *
 * Auto-generated by Apso CLI from .apsorc auth configuration
 * Generated at: <%= it.generatedAt %>
 *
 * This guard:
 * - Reads the key from the <%= it.apiKey.apiKeyHeader %> header
 * - Looks up the <%= it.apiKey.apiKeyEntity %> row whose <%= it.apiKey.keyField %> is the key's hex SHA-256
<% if (it.apiKey.hasStatus) { %>
 * - Rejects keys whose status is not "active"
<% } %>
<% if (it.apiKey.hasExpiresAt) { %>
 * - Rejects keys past expiresAt
<% } %>
 * - Attaches a normalized AuthContext to request.auth
 *
 * DO NOT EDIT - Changes will be overwritten on next scaffold
 */
import {
  Injectable,
  CanActivate,
  ExecutionContext,
  UnauthorizedException,
} from '@nestjs/common';
import { Reflector } from '@nestjs/core';
import { InjectRepository } from '@nestjs/typeorm';
import { Repository } from 'typeorm';
import { createHash } from 'crypto';

import { <%= it.apiKey.apiKeyEntity %> } from '../<%= it.apiKey.apiKeyEntity %>/<%= it.apiKey.apiKeyEntity %>.entity';

export const IS_PUBLIC_KEY = 'isPublic';

/**
 * Decorator to mark a route as public (skips authentication)
 * Usage: @Public()
 */
export const Public =
  () => (target: any, key?: string, descriptor?: PropertyDescriptor) => {
    Reflect.defineMetadata(IS_PUBLIC_KEY, true, descriptor?.value || target);
  };

/**
 * Normalized auth context attached to authenticated requests.
 * This is what scopeBy and RBAC consume.
 */
export interface AuthContext {
  userId?: string;
  serviceId: string;
  workspaceId?: string;
  organizationId?: string;
  roles: string[];
}

@Injectable()
export class AuthGuard implements CanActivate {
  constructor(
    private reflector: Reflector,
    @InjectRepository(<%= it.apiKey.apiKeyEntity %>)
    private apiKeyRepository: Repository<<%= it.apiKey.apiKeyEntity %>>,
  ) {}

  async canActivate(context: ExecutionContext): Promise<boolean> {
    const isPublic = this.reflector.getAllAndOverride<boolean>(IS_PUBLIC_KEY, [
      context.getHandler(),
      context.getClass(),
    ]);
    if (isPublic) {
      return true;
    }

    // The template's health check stays public for load balancer probes.
    const req = context.switchToHttp().getRequest();
    if (req.method === 'GET' && /^\/health\/?$/.test(req.path)) {
      return true;
    }

    const request = context.switchToHttp().getRequest();
    const key = request.headers['<%= it.apiKey.apiKeyHeader %>'];
    if (typeof key !== 'string' || !key) {
      throw new UnauthorizedException('No API key provided');
    }

    const hash = createHash('sha256').update(key).digest('hex');
    const record: any = await this.apiKeyRepository.findOne({
      where: { <%= it.apiKey.keyField %>: hash } as any,
    });
    if (!record) {
      throw new UnauthorizedException('Invalid API key');
    }
<% if (it.apiKey.hasStatus) { %>
    if (record.status !== 'active') {
      throw new UnauthorizedException('API key is not active');
    }
<% } %>
<% if (it.apiKey.hasExpiresAt) { %>
    if (record.expiresAt && new Date(record.expiresAt) <= new Date()) {
      throw new UnauthorizedException('API key has expired');
    }
<% } %>

    const tenant =
      record.<%= it.apiKey.workspaceField %> != null
        ? String(record.<%= it.apiKey.workspaceField %>)
        : undefined;
<% if (it.apiKey.roleField) { %>
    const role = record.<%= it.apiKey.roleField %>;
    const roles = Array.isArray(role) ? role.map(String) : role ? [String(role)] : [];
<% } else { %>
    const roles: string[] = [];
<% } %>
    const auth: AuthContext = {
      serviceId: String(record.id),
      workspaceId: tenant,
      organizationId: tenant,
      roles,
    };

    request.auth = auth;
    request.user = { id: auth.serviceId, ...auth };
    // Read by ScopeGuard's scope lookup.
    request.workspaceId = tenant;
    request.organizationId = tenant;
    return true;
  }
}

/**
 * Helper function to get AuthContext from request
 * Use this in controllers/services to access the authenticated context
 */
export function getAuthContext(request: any): AuthContext | undefined {
  return request?.auth;
}

/**
 * Helper function to require AuthContext (throws if not present)
 */
export function requireAuthContext(request: any): AuthContext {
  const ctx = getAuthContext(request);
  if (!ctx) {
    throw new UnauthorizedException('Authentication required');
  }
  return ctx;
}
