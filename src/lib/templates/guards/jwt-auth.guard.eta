/**
 * AuthGuard - verifies <%= it.jwt.map((p) => p.provider).join(', ') %> JWTs against the issuer's JWKS
 *
 * Auto-generated by Apso CLI from .apsorc auth configuration
 *
 * This guard:
 * - Reads the token from the Authorization: Bearer header
 * - Picks the provider whose issuer is the token's iss claim. A token from an
 *   issuer that is not configured is refused, and no other provider is tried
 * - Verifies its signature with that issuer's published keys, plus issuer,
 *   expiry, audience (when one is configured) and algorithm
 * - Maps the token's claims, by that provider's claim names, into a
 *   normalized AuthContext on request.auth
 *
 * AUTH_JWT_ISSUER, AUTH_JWT_AUDIENCE, AUTH_JWKS_URI and
 * AUTH_JWT_AUTHORIZED_PARTIES override the .apsorc values at runtime (for
 * example a staging and a production tenant). With several providers they
 * set the first; the second reads the same names ending in _2
 * (AUTH_JWT_ISSUER_2), and so on.
 *
 * DO NOT EDIT - Changes will be overwritten on next scaffold
 */
import {
  Injectable,
  CanActivate,
  ExecutionContext,
  UnauthorizedException,
} from '@nestjs/common';
import { Reflector } from '@nestjs/core';
import { createRemoteJWKSet, decodeJwt, jwtVerify, JWTPayload } from 'jose';

export const IS_PUBLIC_KEY = 'isPublic';

/**
 * Decorator to mark a route as public (skips authentication)
 * Usage: @Public()
 */
export const Public =
  () => (target: any, key?: string, descriptor?: PropertyDescriptor) => {
    Reflect.defineMetadata(IS_PUBLIC_KEY, true, descriptor?.value || target);
  };

/**
 * Normalized auth context attached to authenticated requests.
 * This is what scopeBy and RBAC consume.
 */
export interface AuthContext {
  userId?: string;
  email?: string;
  workspaceId?: string;
  organizationId?: string;
  roles: string[];
  /** Permission strings from the token ("invoice:delete"), read by PermissionGuard. */
  permissions: string[];
  /** The issuer that signed the caller in, and its provider type in .apsorc. */
  issuer: string;
  provider: string;
  claims: JWTPayload;
}

<% if (it.mcpAuth) { %>
// Public URL of the MCP endpoint (https://api.example.com/mcp). MCP clients ask
// the identity provider for a token for this URL, so it is an accepted audience.
const MCP_RESOURCE = process.env.MCP_RESOURCE_URL || '';
<% } else { %>
const MCP_RESOURCE = '';
<% } %>

/** One trusted issuer: its own keys, audience and claim names. */
const PROVIDERS = (<%~ JSON.stringify(it.jwt) %> as any[]).map((p, i) => {
  // The first provider reads AUTH_JWT_ISSUER, the second AUTH_JWT_ISSUER_2, and so on.
  const env = (name: string) => process.env[i === 0 ? name : `${name}_${i + 1}`];
  const audience = env('AUTH_JWT_AUDIENCE') || p.audience || '';
  return {
    provider: p.provider as string,
    issuer: env('AUTH_JWT_ISSUER') || (p.issuer as string),
    // No configured audience means none is checked (Clerk and Cognito tokens carry no aud).
    audiences: audience ? [audience, MCP_RESOURCE].filter(Boolean) : [],
    jwks: createRemoteJWKSet(new URL(env('AUTH_JWKS_URI') || p.jwksUri)),
    algorithms: p.algorithms as string[],
    authorizedParties: (env('AUTH_JWT_AUTHORIZED_PARTIES') || p.authorizedParties.join(','))
      .split(',')
      .map((s: string) => s.trim())
      .filter(Boolean) as string[],
    claims: p.claims as Record<string, string | undefined>,
  };
});
const BY_ISSUER = new Map(PROVIDERS.map((p) => [p.issuer, p]));
if (BY_ISSUER.size !== PROVIDERS.length) {
  // The token's iss picks the provider, so two providers cannot share one.
  throw new Error('[apso] Two auth providers have the same issuer. Check AUTH_JWT_ISSUER and its numbered variants.');
}

/** A claim by exact name (Auth0 namespaced URLs contain dots), else by dotted path. */
function claim(payload: JWTPayload, path?: string): unknown {
  if (!path) return undefined;
  if (path in payload) return (payload as any)[path];
  return path.split('.').reduce((v: any, k) => (v == null ? undefined : v[k]), payload);
}

const str = (v: unknown): string | undefined =>
  typeof v === 'string' || typeof v === 'number' ? String(v) : undefined;

function roles(v: unknown): string[] {
  if (Array.isArray(v)) return v.map(String);
  return typeof v === 'string' && v ? [v] : [];
}

@Injectable()
export class AuthGuard implements CanActivate {
  constructor(private reflector: Reflector) {}

  async canActivate(context: ExecutionContext): Promise<boolean> {
    const isPublic = this.reflector.getAllAndOverride<boolean>(IS_PUBLIC_KEY, [
      context.getHandler(),
      context.getClass(),
    ]);
    if (isPublic) {
      return true;
    }

    // The template's health check stays public for load balancer probes.
    const req = context.switchToHttp().getRequest();
    if (req.method === 'GET' && /^\/health\/?$/.test(req.path)) {
      return true;
    }

    await this.authenticate(context.switchToHttp().getRequest());
    return true;
  }

  /**
   * Verify the request's bearer token and attach the caller to the request.
   * Throws UnauthorizedException when the token is missing or not accepted.
   */
  async authenticate(request: any): Promise<AuthContext> {
    const header: string | undefined = request.headers.authorization;
    if (!header || !header.startsWith('Bearer ')) {
      throw new UnauthorizedException('No bearer token provided');
    }

    const token = header.substring(7);
    let payload: JWTPayload;
    let provider: (typeof PROVIDERS)[number] | undefined;
    try {
      // The token's own issuer picks the provider, before anything is
      // verified; then only that provider's keys and settings are used.
      provider = BY_ISSUER.get(decodeJwt(token).iss as string);
      if (!provider) throw new Error('issuer not configured');
      ({ payload } = await jwtVerify(token, provider.jwks, {
        issuer: provider.issuer,
        algorithms: provider.algorithms,
        // Cognito's audience is checked below.
        audience:
          provider.provider !== 'cognito' && provider.audiences.length > 0 ? provider.audiences : undefined,
      }));
    } catch {
      throw new UnauthorizedException('Invalid token');
    }
    const { authorizedParties, claims: CLAIMS } = provider;
<% if (it.jwt.some((p) => p.provider === 'cognito')) { %>
    // Cognito ID tokens carry aud; access tokens carry client_id instead.
    if (provider.provider === 'cognito' && provider.audiences.length > 0) {
      const aud = payload.aud ?? (payload as any).client_id;
      const given: unknown[] = Array.isArray(aud) ? aud : [aud];
      if (!given.some((value) => provider.audiences.includes(value as string))) {
        throw new UnauthorizedException('Invalid token');
      }
    }
<% } %>

    const azp = (payload as any).azp;
    if (authorizedParties.length > 0 && azp !== undefined && !authorizedParties.includes(azp)) {
      throw new UnauthorizedException('Invalid token');
    }

    const userId = str(claim(payload, CLAIMS.userId));
    if (!userId) {
      throw new UnauthorizedException('Token has no user id');
    }
    const tenant =
      str(claim(payload, CLAIMS.workspaceId)) ??
      str(claim(payload, CLAIMS.organizationId));
    const auth: AuthContext = {
      userId,
      email: str(claim(payload, CLAIMS.email)),
      workspaceId: tenant,
      organizationId: tenant,
      roles: roles(claim(payload, CLAIMS.roles)),
      permissions: roles(claim(payload, CLAIMS.permissions)),
      issuer: provider.issuer,
      provider: provider.provider,
      claims: payload,
    };

    request.auth = auth;
    request.user = { id: userId, ...auth };
    // Read by ScopeGuard's scope lookup.
    request.workspaceId = tenant;
    request.organizationId = tenant;
    return auth;
  }
}
<% if (it.mcpAuth) { %>

/** Where MCP clients sign in. ApiKeyGuard adds the credential check for @apso/mcp. */
export const MCP_SIGN_IN = {
  authorizationServers: PROVIDERS.map((p) => p.issuer),
  resource: MCP_RESOURCE || undefined,
};
<% } %>

/**
 * Helper function to get AuthContext from request
 * Use this in controllers/services to access the authenticated context
 */
export function getAuthContext(request: any): AuthContext | undefined {
  return request?.auth;
}

/**
 * Helper function to require AuthContext (throws if not present)
 */
export function requireAuthContext(request: any): AuthContext {
  const ctx = getAuthContext(request);
  if (!ctx) {
    throw new UnauthorizedException('Authentication required');
  }
  return ctx;
}
