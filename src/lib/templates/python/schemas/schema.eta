<%~ includeFile('../header.eta', it) %>

from __future__ import annotations
from typing import Annotated, Optional, List, Any
from datetime import datetime, date
from decimal import Decimal
from uuid import UUID
from pydantic import BaseModel, BeforeValidator, Field, ConfigDict, field_serializer, model_validator
from sqlalchemy import inspect as sa_inspect
<% if (it.importEnums) { -%>
from ..models import enums
<% } -%>



def _columns(value: Any) -> Any:
    """A related ORM row as its column values; its own relations are not loaded."""
    if isinstance(value, list):
        return [_columns(v) for v in value]
    if not hasattr(value, "__table__"):
        return value
    return {a.key: getattr(value, a.key) for a in sa_inspect(value).mapper.column_attrs}


def _loaded(value: Any) -> Any:
    """An ORM row as the attributes its query loaded: a relation is in a response only when the request joined it."""
    if not hasattr(value, "__table__"):
        return value
    state = sa_inspect(value)
    return {key: getattr(value, key) for key in state.attrs.keys() if key not in state.unloaded}


<% if (it.associations.some((a) => a.fkIn === 'BigIntKey')) { -%>
def _digits(value: Any) -> Any:
    """A bigint key sent as a JSON number, read as its digits."""
    return str(value) if isinstance(value, int) and not isinstance(value, bool) else value


# A foreign key onto a bigint id in a request body: a string of digits, as
# responses send it and as the API document declares it. A whole JSON number
# is read too. The pattern comes first so the document carries it.
BigIntKey = Annotated[str, Field(pattern="^[0-9]{1,19}$"), BeforeValidator(_digits)]


<% } -%>
class <%= it.entityName %>Base(BaseModel):
    """Base schema with common fields for <%= it.entityName %>"""
<% it.columns.filter(c => !['id', 'createdAt', 'updatedAt', 'created_at', 'updated_at'].includes(c.name)).forEach((field) => { -%>
<%~ includeFile(`./schema-col-${field.schemaTemplate || field.type}`, { field, entityName: it.entityName }) %>
<% }); -%>

<% /* Add foreign key fields for ManyToOne relationships */ -%>
<% it.associations.filter(a => a.type === 'ManyToOne' || (a.type === 'OneToOne' && a.joinTable)).forEach((assoc) => { -%>
    <%= assoc.camelCasedId %>: Optional[<%= assoc.fkIn %>] = None
<% }); -%>


class <%= it.entityName %>Create(BaseModel):
    """Schema for creating a new <%= it.entityName %>"""
<% if (it.suppliesId) { -%>
    id: UUID
<% } -%>
<% it.columns.filter(c => !['id', 'createdAt', 'updatedAt', 'created_at', 'updated_at'].includes(c.name)).forEach((field) => { -%>
<%~ includeFile(`./schema-col-${field.schemaTemplate || field.type}`, { field, entityName: it.entityName, forCreate: true }) %>
<% }); -%>
<% /* Add foreign key fields for ManyToOne relationships */ -%>
<% it.associations.filter(a => a.type === 'ManyToOne' || (a.type === 'OneToOne' && a.joinTable)).forEach((assoc) => { -%>
    <%= assoc.camelCasedId %>: <% if (assoc.nullable || assoc.type === 'OneToOne') { %>Optional[<%= assoc.fkIn %>] = None<% } else { %><%= assoc.fkIn %><% } %>
<% }); -%>


class <%= it.entityName %>Replace(<%= it.entityName %>Create):
    """Schema for replacing a <%= it.entityName %>: the path names the row, so its key columns are optional"""
<% it.replaceKeys.forEach((name) => { -%>
    <%= name %>: Optional[Any] = None
<% }); -%>
<% if (!it.replaceKeys.length) { -%>
    pass
<% } -%>


class <%= it.entityName %>Update(BaseModel):
    """Schema for updating an existing <%= it.entityName %>"""
<% it.columns.filter(c => !['id', 'createdAt', 'updatedAt', 'created_at', 'updated_at'].includes(c.name)).forEach((field) => { -%>
<%~ includeFile(`./schema-col-${field.schemaTemplate || field.type}`, { field, entityName: it.entityName, forUpdate: true }) %>
<% }); -%>
<% /* Add foreign key fields for ManyToOne relationships */ -%>
<% it.associations.filter(a => a.type === 'ManyToOne' || (a.type === 'OneToOne' && a.joinTable)).forEach((assoc) => { -%>
    <%= assoc.camelCasedId %>: Optional[<%= assoc.fkIn %>] = None
<% }); -%>


class <%= it.entityName %>(BaseModel):
    """Full schema for <%= it.entityName %> including all fields"""
    model_config = ConfigDict(from_attributes=True, populate_by_name=True)

    @model_validator(mode="before")
    @classmethod
    def _loaded_only(cls, value: Any) -> Any:
        return _loaded(value)

<% if (it.addDefaultPKProperty) { -%>
<% if (it.primaryKeyType === 'uuid') { -%>
    id: UUID
<% } else if (it.primaryKeyType === 'bigserial') { -%>
    id: str
<% } else { -%>
    id: int
<% } -%>
<% } -%>
<% if (it.createdAt) { -%>
    createdAt: datetime = Field(alias="created_at")
<% } -%>
<% if (it.updatedAt) { -%>
    updatedAt: datetime = Field(alias="updated_at")
<% } -%>
<% it.columns.filter(c => !['id', 'createdAt', 'updatedAt', 'created_at', 'updated_at'].includes(c.name)).forEach((field) => { -%>
<%~ includeFile(`./schema-col-${field.schemaTemplate || field.type}`, { field, entityName: it.entityName }) %>
<% }); -%>
<% /* Add foreign key fields for ManyToOne relationships */ -%>
<% it.associations.filter(a => a.type === 'ManyToOne' || (a.type === 'OneToOne' && a.joinTable)).forEach((assoc) => { -%>
    <%= assoc.camelCasedId %>: Optional[<%= assoc.fkOut %>] = None
<% }); -%>
<% /* Add relationship fields */ -%>
<% it.associations.filter(a => !a.hidden && (a.type === 'OneToMany' || a.type === 'ManyToMany')).forEach((assoc) => { -%>
    <%= assoc.pluralizedRelationshipName %>: Optional[List[Any]] = None
<% }); -%>
<% it.associations.filter(a => !a.hidden && (a.type === 'ManyToOne' || a.type === 'OneToOne')).forEach((assoc) => { -%>
    <%= assoc.relationshipName %>: Optional[Any] = None
<% }); -%>
<% const relationFields = [
  ...it.associations.filter(a => !a.hidden && (a.type === 'OneToMany' || a.type === 'ManyToMany')).map(a => a.pluralizedRelationshipName),
  ...it.associations.filter(a => !a.hidden && (a.type === 'ManyToOne' || a.type === 'OneToOne')).map(a => a.relationshipName),
]; -%>
<% if (relationFields.length > 0) { -%>

    @field_serializer(<%~ [...new Set(relationFields)].map(n => JSON.stringify(n)).join(', ') %>)
    def _serialize_relations(self, value: Any) -> Any:
        return _columns(value)
<% } -%>


class <%= it.entityName %>List(BaseModel):
    """Paginated list response for <%= it.entityName %>"""
    data: List[<%= it.entityName %>]
    count: int
    total: int
    page: int
    pageCount: int
