<%~ includeFile('../header.eta', it) %>

from __future__ import annotations
from typing import TYPE_CHECKING, Optional, List
from datetime import datetime, date
from decimal import Decimal
from uuid import UUID

from sqlalchemy import CHAR, Column, Integer, SmallInteger, BigInteger, String, Text, Boolean, Float, Numeric, Date, DateTime, JSON, Enum as SAEnum, ForeignKey, Index, PrimaryKeyConstraint, UniqueConstraint, Table, text
from sqlalchemy.dialects.postgresql import UUID as PGUUID, JSONB, ARRAY, DOUBLE_PRECISION, REAL
from sqlalchemy.orm import relationship, Mapped, mapped_column
from sqlalchemy.sql import func

from app.database import Base
<% if (it.importEnums) { %>
from . import enums
<% } %>

<% if (it.entitiesToImport && it.entitiesToImport.length > 0) { %>
if TYPE_CHECKING:
<% it.entitiesToImport.forEach((assocName) => { %>
    from .<%= assocName.toLowerCase() %> import <%= assocName %>
<% }) %>
<% } %>

# Tables, columns, keys, indexes and constraints are named and typed exactly as
# the migrations from `apso migrate` create them.
<% it.joinTables.forEach((join) => { %>
<%= join.name %> = Table(
    "<%= join.name %>",
    Base.metadata,
<% join.columns.forEach((c) => { %>
    Column("<%= c.name %>", <%~ c.args.join(', ') %>),
<% }) %>
<% join.tableArgs.forEach((a) => { %>
    <%~ a %>,
<% }) %>
)
<% }) %>

class <%= it.name %>(Base):
    """
    SQLAlchemy model for <%= it.name %>
    """
    __tablename__ = "<%= it.tableName %>"
    __table_args__ = (
<% it.tableArgs.forEach((a) => { %>
        <%~ a %>,
<% }) %>
    )

<% it.columns.forEach((c) => { %>
    <%= c.name %>: Mapped[<%~ c.pyType %>] = mapped_column(<%~ c.args.join(', ') %>)
<% }) %>

    # Relationships. A relation is loaded only when a request joins it
    # (selectinload in the query builder), never by reading the attribute.
<% it.associations.forEach((assoc) => { %>
<% if (assoc.type === 'OneToMany') { %>
    <%= assoc.pluralizedRelationshipName %>: Mapped[List["<%= assoc.name %>"]] = relationship(
        "<%= assoc.name %>",
        back_populates="<%= assoc.inverseSidePropertyName %>",
        # The foreign key's ON DELETE decides, not the ORM (it would null it).
        passive_deletes="all",
        lazy="raise"
    )
<% } else if (assoc.type === 'ManyToOne' || (assoc.type === 'OneToOne' && assoc.joinTable)) { %>
    <%= assoc.relationshipName %>: Mapped[Optional["<%= assoc.name %>"]] = relationship(
        "<%= assoc.name %>",
        foreign_keys=[<%= assoc.type === 'ManyToOne' ? assoc.camelCasedId : assoc.fkColumn %>],
        <% if (assoc.biDirectional) { %>back_populates="<%= assoc.inverseSidePropertyName %>",<% } %>
        lazy="raise"
    )
<% } else if (assoc.type === 'ManyToMany' && assoc.secondary) { %>
    <%= assoc.pluralizedRelationshipName %>: Mapped[List["<%= assoc.name %>"]] = relationship(
        "<%= assoc.name %>",
        secondary="<%= assoc.secondary %>",
        <% if (assoc.biDirectional) { %>back_populates="<%= assoc.inverseSidePropertyName %>",<% } %>
        lazy="raise"
    )
<% } else if (assoc.type === 'OneToOne') { %>
    <%= assoc.relationshipName %>: Mapped[Optional["<%= assoc.name %>"]] = relationship(
        "<%= assoc.name %>",
        <% if (assoc.biDirectional) { %>back_populates="<%= assoc.inverseSidePropertyName %>",<% } %>
        uselist=False,
        cascade="all, delete-orphan",
        lazy="raise"
    )
<% } %>
<% }) %>

    def __repr__(self) -> str:
        return f"<<%= it.name %>(id={self.id})>"
