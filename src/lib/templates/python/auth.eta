<%~ includeFile('./header.eta', it) %>

"""
Authentication for every route on the generated /api router.

The API key check is built into every Apso service and is not configurable in
.apsorc. The key source is chosen once, when the service starts, first match
wins:
1. APSO_API_KEY is set: the x-api-key header must match it. The variable holds
   the key itself (not a hash); several keys separated by commas are accepted,
   so a key can be rotated without downtime.
2. APSO_SERVICE_TOKEN_JWKS_URL is set: the platform's gateway has checked the
   key and sends a signed token in x-apso-service-token.
3. Neither: API keys are off and only signed-in users are accepted. A service
   with no sign-in configured then refuses every request.

A caller with a valid key is a service caller (AuthContext.service_id): it may
call any route and is not tenant-scoped. A request whose key fails is refused,
whatever else it carries.
<% if (it.jwt) { %>

A request with no key needs a <%= it.jwt.map((p) => p.provider).join(', ') %> JWT in the Authorization: Bearer header.
The token's iss claim picks the provider; a token from an issuer that is not
configured is refused. It is verified against that issuer's published keys
(JWKS) with issuer, expiry, audience (when one is configured) and algorithm
checked; its claims, by that provider's claim names, become the AuthContext on
request.state.auth.
AUTH_JWT_ISSUER, AUTH_JWT_AUDIENCE, AUTH_JWKS_URI and AUTH_JWT_AUTHORIZED_PARTIES
override the .apsorc values. With several providers they set the first; the
second reads the same names ending in _2 (AUTH_JWT_ISSUER_2), and so on.
<% } %>
"""
import hashlib
import hmac
import os
import uuid
from dataclasses import dataclass, field
from typing import Any, List, NoReturn, Optional
from urllib.parse import urlsplit

import jwt
from fastapi import HTTPException, Request, Response, status
from jwt import PyJWKClient
from starlette.concurrency import run_in_threadpool


@dataclass
class AuthContext:
    """The normalized identity of the caller."""

    user_id: Optional[str] = None
    email: Optional[str] = None
    service_id: Optional[str] = None
    workspace_id: Optional[str] = None
    organization_id: Optional[str] = None
    roles: List[str] = field(default_factory=list)
    # The issuer that signed the caller in, and its provider type in .apsorc.
    issuer: Optional[str] = None
    provider: Optional[str] = None
    claims: dict = field(default_factory=dict)


def get_auth_context(request: Request) -> Optional[AuthContext]:
    """The authenticated caller, if any."""
    return getattr(request.state, "auth", None)


def _unauthorized(detail: str) -> HTTPException:
    return HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail=detail)
<% if (it.jwt) { %>


_CONFIGURED = <%~ JSON.stringify(it.jwt) %>


def _provider(i: int, p: dict) -> dict:
    """One trusted issuer: its own keys, audience and claim names."""
    # The first provider reads AUTH_JWT_ISSUER, the second AUTH_JWT_ISSUER_2, and so on.
    s = "" if i == 0 else f"_{i + 1}"
    parties = os.getenv(f"AUTH_JWT_AUTHORIZED_PARTIES{s}") or ",".join(p["authorizedParties"])
    issuer = os.getenv(f"AUTH_JWT_ISSUER{s}") or p["issuer"]
    # Better Auth: the OAuth provider signs with the base URL, the JWT plugin
    # with its origin as iss and aud. Both are this provider, with the same keys.
    origin = "{0.scheme}://{0.netloc}".format(urlsplit(issuer)) if p["provider"] == "better-auth" else ""
    return {
        "provider": p["provider"],
        "issuer": issuer,
        "issuers": {issuer, origin} if origin else {issuer},
        "audience": os.getenv(f"AUTH_JWT_AUDIENCE{s}") or p.get("audience") or origin,
        # Fetches and caches the issuer's keys on first use.
        "jwks": PyJWKClient(os.getenv(f"AUTH_JWKS_URI{s}") or p["jwksUri"], cache_keys=True),
        "algorithms": p["algorithms"],
        # Origins allowed in the azp claim; empty allows any.
        "authorized_parties": [x.strip() for x in parties.split(",") if x.strip()],
        "claims": p["claims"],
    }


_PROVIDERS = [_provider(i, p) for i, p in enumerate(_CONFIGURED)]
PROVIDERS = {issuer: p for p in _PROVIDERS for issuer in p["issuers"]}
if len(PROVIDERS) != sum(len(p["issuers"]) for p in _PROVIDERS):
    # The token's iss picks the provider, so two providers cannot share one.
    raise RuntimeError(
        "[apso] Two auth providers have the same issuer. Check AUTH_JWT_ISSUER and its numbered variants."
    )


def _claim(payload: dict, path: Optional[str]) -> Any:
    """A claim by exact name (Auth0 namespaced URLs contain dots), else by dotted path."""
    if not path:
        return None
    if path in payload:
        return payload[path]
    value: Any = payload
    for part in path.split("."):
        if not isinstance(value, dict):
            return None
        value = value.get(part)
    return value


def _str(value: Any) -> Optional[str]:
    if isinstance(value, bool):
        return None
    if isinstance(value, (str, int, float)):
        return str(value)
    return None


def _roles(value: Any) -> List[str]:
    if isinstance(value, list):
        return [str(v) for v in value]
    return [value] if isinstance(value, str) and value else []


async def _require_user(request: Request) -> AuthContext:
    """Verify the bearer token and return the signed-in user's AuthContext."""
    header = request.headers.get("authorization", "")
    if not header.startswith("Bearer "):
        raise _unauthorized("No bearer token provided")
    token = header[len("Bearer "):]
    # The token's own issuer picks the provider, before anything is verified;
    # then only that provider's keys and settings are used.
    try:
        iss = jwt.decode(token, options={"verify_signature": False}).get("iss")
    except jwt.PyJWTError:
        raise _unauthorized("Invalid token")
    p = PROVIDERS.get(iss) if isinstance(iss, str) else None
    if p is None:
        raise _unauthorized("Invalid token")
    AUDIENCE, CLAIMS, cognito = p["audience"], p["claims"], p["provider"] == "cognito"
    try:
        signing_key = await run_in_threadpool(p["jwks"].get_signing_key_from_jwt, token)
    except jwt.PyJWKClientConnectionError:
        raise HTTPException(
            status_code=status.HTTP_503_SERVICE_UNAVAILABLE,
            detail="Token signing keys unavailable",
        )
    except jwt.PyJWTError:
        raise _unauthorized("Invalid token")
    try:
        payload = jwt.decode(
            token,
            signing_key.key,
            algorithms=p["algorithms"],
            issuer=iss,
            # Cognito's audience is checked below.
            audience=None if cognito else AUDIENCE or None,
            options={"require": ["exp", "iss"], "verify_aud": bool(AUDIENCE) and not cognito},
        )
    except jwt.PyJWTError:
        raise _unauthorized("Invalid token")
<% if (it.jwt.some((p) => p.provider === 'cognito')) { %>
    # Cognito ID tokens carry aud; access tokens carry client_id instead.
    if cognito and AUDIENCE:
        aud = payload.get("aud", payload.get("client_id"))
        if not (AUDIENCE in aud if isinstance(aud, list) else aud == AUDIENCE):
            raise _unauthorized("Invalid token")
<% } %>

    azp = payload.get("azp")
<% if (it.jwt.some((p) => p.provider === 'better-auth')) { %>
    # Better Auth's OAuth access tokens (header type at+jwt) name their client in azp.
    if p["provider"] == "better-auth" and jwt.get_unverified_header(token).get("typ") == "at+jwt" and not isinstance(azp, str):
        raise _unauthorized("Invalid token")
<% } %>
    if p["authorized_parties"] and azp is not None and azp not in p["authorized_parties"]:
        raise _unauthorized("Invalid token")

    user_id = _str(_claim(payload, CLAIMS.get("userId")))
    if not user_id:
        raise _unauthorized("Token has no user id")
    tenant = _str(_claim(payload, CLAIMS.get("workspaceId"))) or _str(
        _claim(payload, CLAIMS.get("organizationId"))
    )
    ctx = AuthContext(
        user_id=user_id,
        email=_str(_claim(payload, CLAIMS.get("email"))),
        workspace_id=tenant,
        organization_id=tenant,
        roles=_roles(_claim(payload, CLAIMS.get("roles"))),
        issuer=iss,
        provider=p["provider"],
        claims=payload,
    )
    return ctx
<% } %>


NO_SOURCE = (
    "This service has no API key source and no sign-in configured, so it refuses every request. "
    'Set APSO_API_KEY in its environment; "apso dev" creates a development key in .env.'
)
NO_CREDENTIAL = "No credential on the request. Send the API key in the x-api-key header."
WRONG_KEY = "The key in the x-api-key header does not match APSO_API_KEY."
NO_SERVICE_TOKEN = (
    "This service takes API keys through the platform gateway, and the request has no valid "
    "x-apso-service-token. Call the service at its gateway URL with a key issued for it."
)
KEYS_OFF = "An x-api-key header was sent, but API keys are off on this service. Set APSO_API_KEY to turn them on."
HAS_SIGN_IN = <%= it.jwt ? 'True' : 'False' %>

# The detailed 401 is for a developer's machine only: "apso dev" sets
# APSO_LOCAL, and Lambda ignores it.
LOCAL = os.getenv("APSO_LOCAL") == "1" and not os.getenv("AWS_LAMBDA_FUNCTION_NAME")

# The key source, chosen once at start-up.
_KEYS = [
    hashlib.sha256(k.strip().encode()).digest()
    for k in os.getenv("APSO_API_KEY", "").split(",")
    if k.strip()
]
_SERVICE_JWKS_URL = "" if _KEYS else os.getenv("APSO_SERVICE_TOKEN_JWKS_URL", "")
_SERVICE_JWKS = PyJWKClient(_SERVICE_JWKS_URL, cache_keys=True) if _SERVICE_JWKS_URL else None
_SERVICE_ISSUER = os.getenv("APSO_SERVICE_TOKEN_ISSUER", "")
_SERVICE_ID = os.getenv("APSO_SERVICE_ID", "")

if _KEYS:
    print(f"[apso] API keys: checked against APSO_API_KEY ({len(_KEYS)} set)", flush=True)
elif _SERVICE_JWKS:
    print("[apso] API keys: checked by the platform gateway (APSO_SERVICE_TOKEN_JWKS_URL)", flush=True)
    if not (_SERVICE_ISSUER and _SERVICE_ID):
        print(
            "[apso] WARNING: APSO_SERVICE_TOKEN_ISSUER and APSO_SERVICE_ID must both be set; "
            "until then every API key is refused.",
            flush=True,
        )
else:
    print("[apso] API keys: off (neither APSO_API_KEY nor APSO_SERVICE_TOKEN_JWKS_URL is set)", flush=True)
    if not HAS_SIGN_IN:
        print(f"[apso] WARNING: {NO_SOURCE}", flush=True)


def _refuse(request: Request, reason: str) -> NoReturn:
    """401. The reason goes to the log, and to the caller only on a developer's machine."""
    request_id = request.state.request_id
    print(f"[apso] 401 {request.method} {request.url.path} request={request_id}: {reason}", flush=True)
    raise HTTPException(
        status_code=status.HTTP_401_UNAUTHORIZED,
        detail={"message": reason if LOCAL else "Unauthorized", "requestId": request_id},
        headers={"x-request-id": request_id},
    )


def _service_token_key_id(token: str) -> Optional[str]:
    """The key id from the gateway's token (sub "apikey:<id>"), when the token is valid for this service."""
    if not (_SERVICE_JWKS and _SERVICE_ISSUER and _SERVICE_ID):
        return None
    try:
        signing_key = _SERVICE_JWKS.get_signing_key_from_jwt(token)
        payload = jwt.decode(
            token,
            signing_key.key,
            algorithms=["ES256"],
            issuer=_SERVICE_ISSUER,
            audience=_SERVICE_ID,
            options={"require": ["exp", "iss", "aud", "sub"]},
        )
    except jwt.PyJWTError:
        return None
    sub = payload["sub"]
    return sub[len("apikey:"):] or None if isinstance(sub, str) and sub.startswith("apikey:") else None


async def _service_caller(request: Request) -> Optional[AuthContext]:
    """
    The service caller when the request carries a valid key, None when it
    presents none. A key that fails the chosen source is refused here; no
    other source and no user token is tried.
    """
    key = request.headers.get("x-api-key")
    if _KEYS:
        if not key:
            return None
        digest = hashlib.sha256(key.encode()).digest()
        # Every key is compared, in constant time.
        matches = [k for k in _KEYS if hmac.compare_digest(k, digest)]
        if not matches:
            _refuse(request, WRONG_KEY)
        key_id = matches[0].hex()[:8]
    elif _SERVICE_JWKS:
        token = request.headers.get("x-apso-service-token")
        if not key and not token:
            return None
        key_id = await run_in_threadpool(_service_token_key_id, token) if token else None
        if not key_id:
            _refuse(request, NO_SERVICE_TOKEN)
    else:
        if not key:
            return None
        _refuse(request, KEYS_OFF)
    return AuthContext(service_id=key_id)


async def require_auth(request: Request, response: Response) -> AuthContext:
    """FastAPI dependency: accept a valid API key<% if (it.jwt) { %>, else a signed-in user<% } %>; attach the AuthContext."""
    request_id = request.headers.get("x-request-id") or str(uuid.uuid4())
    request.state.request_id = request_id
    response.headers["x-request-id"] = request_id
    ctx = await _service_caller(request)
    if ctx is None:
<% if (it.jwt) { %>
        try:
            ctx = await _require_user(request)
        except HTTPException as e:
            if e.status_code != status.HTTP_401_UNAUTHORIZED:
                raise
            _refuse(request, f"{e.detail}. Send a signed-in user's token, or an API key in the x-api-key header.")
<% } else { %>
        _refuse(request, NO_CREDENTIAL if _KEYS or _SERVICE_JWKS else NO_SOURCE)
<% } %>
    request.state.auth = ctx
    return ctx
