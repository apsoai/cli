{
  "version": 2,
  "rootFolder": "src",
  "apiType": "Rest",
  "entities": [
    {
      "name": "Company",
      "created_at": true,
      "updated_at": true,
      "fields": [
        {
          "name": "name",
          "type": "text"
        }
      ]
    },
    {
      "name": "Contact",
      "created_at": true,
      "updated_at": true,
      "fields": [
        {
          "name": "fullName",
          "type": "text"
        },
        {
          "name": "status",
          "type": "enum",
          "values": [
            "lead",
            "active",
            "archived"
          ],
          "default": "lead"
        },
        {
          "name": "score",
          "type": "text",
          "nullable": true
        }
      ]
    },
    {
      "name": "PhoneNumber",
      "created_at": true,
      "updated_at": true,
      "fields": [
        {
          "name": "number",
          "type": "varchar",
          "length": 40
        },
        {
          "name": "label",
          "type": "enum",
          "values": [
            "mobile",
            "work",
            "home"
          ],
          "default": "mobile"
        }
      ]
    }
  ],
  "relationships": [
    {
      "from": "Contact",
      "to": "Company",
      "type": "ManyToOne",
      "index": true
    },
    {
      "from": "PhoneNumber",
      "to": "Contact",
      "type": "ManyToOne",
      "index": true,
      "cascadeDelete": true
    }
  ]
}