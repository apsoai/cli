{
  "version": 2,
  "rootFolder": "src",
  "apiType": "rest",
  "entities": [
    { "name": "Organization", "created_at": true, "updated_at": true, "timestampType": "timestamptz", "fields": [{ "name": "name", "type": "text" }] },
    { "name": "Patient", "created_at": true, "updated_at": true, "timestampType": "timestamptz", "fields": [{ "name": "mrn", "type": "text", "nullable": true }] },
    {
      "name": "Enrollment",
      "created_at": true,
      "updated_at": true,
      "fields": [{ "name": "performance_year", "type": "integer" }, { "name": "status", "type": "text" }],
      "uniques": [{ "fields": ["patient", "performance_year"], "name": "enrollments_patient_year_uq" }],
      "indexes": [{ "fields": ["organization", "patient"] }, { "fields": ["organizationId", "status"] }]
    },
    { "name": "Profile", "created_at": true, "updated_at": true, "timestampType": { "created_at": "timestamptz" }, "fields": [{ "name": "bio", "type": "text", "nullable": true }] }
  ],
  "relationships": [
    { "from": "Patient", "to": "Organization", "type": "ManyToOne", "joinColumnName": "organization_id", "onDelete": "RESTRICT" },
    { "from": "Enrollment", "to": "Organization", "type": "ManyToOne", "joinColumnName": "organization_id" },
    { "from": "Enrollment", "to": "Patient", "type": "ManyToOne", "joinColumnName": "patient_id", "index": true, "nullable": true, "onDelete": "SET NULL" },
    { "from": "Profile", "to": "Patient", "type": "OneToOne", "joinColumnName": "patient_id" }
  ]
}
