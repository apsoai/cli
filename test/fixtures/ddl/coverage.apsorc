{
  "version": 2,
  "rootFolder": "src",
  "apiType": "Rest",
  "entities": [
    {
      "name": "Account",
      "created_at": true,
      "updated_at": true,
      "fields": [
        { "name": "handle", "type": "text", "unique": true, "index": true },
        { "name": "code", "type": "char", "length": 3, "nullable": true },
        { "name": "active", "type": "boolean" },
        { "name": "verified", "type": "boolean", "default": "false" },
        { "name": "visits", "type": "bigint", "default": "0" },
        { "name": "visits_doubled", "type": "bigint", "generated": "visits * 2", "nullable": true },
        { "name": "busy", "type": "boolean", "generated": "visits > 10" },
        { "name": "balance", "type": "decimal", "precision": 12, "scale": 4, "nullable": true },
        { "name": "ratio", "type": "float", "nullable": true },
        { "name": "score", "type": "double", "nullable": true },
        { "name": "born", "type": "date", "nullable": true },
        { "name": "seenAt", "type": "timestamptz", "nullable": true },
        { "name": "prefs", "type": "json", "nullable": true },
        { "name": "raw", "type": "json-plain", "nullable": true },
        { "name": "tier", "type": "enum", "values": ["free", "pro"], "index": true },
        { "name": "labels", "type": "array" },
        { "name": "lucky", "type": "array", "elementType": "integer", "nullable": true, "index": true },
        { "name": "avatar", "type": "bytea", "nullable": true },
        { "name": "weight", "type": "real", "nullable": true },
        { "name": "credit", "type": "money", "nullable": true },
        { "name": "opensAt", "type": "time", "nullable": true },
        { "name": "closesAt", "type": "timetz", "nullable": true },
        { "name": "trial", "type": "interval", "nullable": true },
        { "name": "lastIp", "type": "inet", "nullable": true, "index": true },
        { "name": "profileXml", "type": "xml", "nullable": true },
        { "name": "search", "type": "tsvector", "nullable": true },
        { "name": "ageBand", "type": "int4range", "nullable": true }
      ],
      "indexes": [{ "fields": ["code", "tier"] }, { "fields": ["visits"], "unique": true }],
      "uniques": [{ "name": "unique_account_code_born", "fields": ["code", "born"] }, { "fields": ["ratio", "score"] }]
    },
    {
      "name": "Profile",
      "table": "account_profile",
      "fields": [{ "name": "bio", "type": "varchar", "length": 500, "nullable": true }]
    },
    {
      "name": "Tag",
      "fields": [{ "name": "label", "type": "varchar", "unique": true }]
    },
    {
      "name": "Post",
      "foreignKeys": [
        { "name": "post_account_second_fk", "column": "accountId", "to": "Account" },
        { "name": "post_account_tag_fk", "column": "accountId", "to": "Tag", "onDelete": "CASCADE", "onUpdate": "CASCADE", "deferrable": "INITIALLY DEFERRED" }
      ],
      "fields": [{ "name": "title", "type": "string" }]
    },
    {
      "name": "AccountFlag",
      "fields": [{ "name": "flag", "type": "text" }]
    },
    {
      "name": "FlagNote",
      "foreignKeys": [{ "name": "flag_note_second_fk", "column": "account_flag_id", "to": "AccountFlag" }],
      "fields": [{ "name": "note", "type": "text" }, { "name": "rank", "type": "integer", "default": "0" }]
    },
    {"name": "Ledger", "primaryKeyType": "bigserial", "primaryKeyName": "ledger_pkey", "fields": [{"name": "state", "type": "enum", "values": ["open", "held", "closed"], "enumName": "review_state", "default": "open"}, {"name": "priorState", "type": "enum", "values": ["open", "held", "closed"], "enumName": "review_state", "nullable": true, "default": null}]},
    {"name": "LedgerNote", "primaryKeyType": "uuid", "primaryKeyDefault": null, "fields": [{"name": "body", "type": "text"}]}
  ],
  "relationships": [
    { "from": "Post", "to": "Account", "type": "ManyToOne", "cascadeDelete": true, "index": true },
    { "from": "Post", "to": "Profile", "type": "ManyToOne", "nullable": true },
    { "from": "Post", "to": "Tag", "type": "ManyToMany" },
    { "from": "Account", "to": "Profile", "type": "OneToOne" },
    { "from": "AccountFlag", "to": "Account", "type": "ManyToOne", "joinColumnName": "account_id", "primary": true, "bi_directional": false, "onUpdate": "CASCADE", "deferrable": "INITIALLY IMMEDIATE" },
    { "from": "FlagNote", "to": "AccountFlag", "type": "ManyToOne", "joinColumnName": "account_flag_id", "bi_directional": false, "onDelete": "SET DEFAULT", "onUpdate": "RESTRICT", "deferrable": "INITIALLY DEFERRED", "joinColumnDefault": "0" },
    { "from": "AccountFlag", "to": "Tag", "type": "ManyToMany" },
    { "from": "Tag", "to": "Tag", "type": "ManyToOne", "to_name": "parent", "nullable": true, "cascadeDelete": true },
    {"from": "LedgerNote", "to": "Ledger", "type": "ManyToOne", "cascadeDelete": true}
  ]
}
