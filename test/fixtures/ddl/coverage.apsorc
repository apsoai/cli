{
  "version": 2,
  "rootFolder": "src",
  "apiType": "Rest",
  "entities": [
    {
      "name": "Account",
      "created_at": true,
      "updated_at": true,
      "fields": [
        { "name": "handle", "type": "text", "unique": true, "index": true },
        { "name": "code", "type": "char", "length": 3, "nullable": true },
        { "name": "active", "type": "boolean" },
        { "name": "verified", "type": "boolean", "default": "false" },
        { "name": "visits", "type": "bigint", "default": "0" },
        { "name": "balance", "type": "decimal", "precision": 12, "scale": 4, "nullable": true },
        { "name": "ratio", "type": "float", "nullable": true },
        { "name": "score", "type": "double", "nullable": true },
        { "name": "born", "type": "date", "nullable": true },
        { "name": "seenAt", "type": "timestamptz", "nullable": true },
        { "name": "prefs", "type": "json", "nullable": true },
        { "name": "raw", "type": "json-plain", "nullable": true },
        { "name": "tier", "type": "enum", "values": ["free", "pro"], "index": true }
      ],
      "indexes": [{ "fields": ["code", "tier"] }, { "fields": ["visits"], "unique": true }],
      "uniques": [{ "name": "unique_account_code_born", "fields": ["code", "born"] }, { "fields": ["ratio", "score"] }]
    },
    {
      "name": "Profile",
      "table": "account_profile",
      "fields": [{ "name": "bio", "type": "varchar", "length": 500, "nullable": true }]
    },
    {
      "name": "Tag",
      "fields": [{ "name": "label", "type": "varchar", "unique": true }]
    },
    {
      "name": "Post",
      "fields": [{ "name": "title", "type": "string" }]
    }
  ],
  "relationships": [
    { "from": "Post", "to": "Account", "type": "ManyToOne", "cascadeDelete": true, "index": true },
    { "from": "Post", "to": "Profile", "type": "ManyToOne", "nullable": true },
    { "from": "Post", "to": "Tag", "type": "ManyToMany" },
    { "from": "Account", "to": "Profile", "type": "OneToOne" }
  ]
}
